[Unit]
Description=Buzz for Omarchy integration helper
Requires=omarchy-buzz.socket
After=omarchy-buzz.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-buzz daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=32
LimitNOFILE=128

# The socket owns its runtime directory across normal daemon idle exits.
# Session D-Bus access is required for the user's Secret Service.
