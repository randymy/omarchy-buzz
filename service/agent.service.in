# Generated by `omarchy-buzz agents-daemon` from the reviewed template
# service/agent.service.in. It is rewritten before every start; do not edit.
[Unit]
Description=Buzz for Omarchy agent @AGENT_ID@

[Service]
Type=simple
ExecStart=@EXEC_START@
Restart=no
KillMode=control-group
TimeoutStopSec=10
UMask=0077
MemoryMax=2G
TasksMax=128
LimitCORE=0
StandardInput=null
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
