[Unit]
Description=Buzz for Omarchy agent manager
Requires=omarchy-buzz-agents.socket
After=omarchy-buzz-agents.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-buzz agents-daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=64
LimitNOFILE=256
LimitCORE=0

# Socket-activated; the daemon exits 30 s after its last client unless a
# request is still running. It needs the session D-Bus (Secret Service and
# `systemctl --user`). Per-agent units are generated from agent.service.in.
