+    let mut writer = LimitedJson {
+        bytes: Vec::new(),
+        limit: 128,
+        exceeded: false,
+    };
+    assert!(serde_json::to_writer(&mut writer, &json!("x".repeat(10000))).is_err());
+    assert!(writer.exceeded);
+    assert!(writer.bytes.len() <= 128);
+}
