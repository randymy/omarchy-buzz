+            "BUZZ_ACP_API_TOKEN",
+            "BUZZ_AUTH_TAG",
+            "GIT_CONFIG_COUNT",
+            "GIT_CONFIG_KEY_0",
+            "GIT_CONFIG_VALUE_0",
+            "GIT_CONFIG_GLOBAL",
+            "GIT_CONFIG_PARAMETERS",
+        ];
+        let extra = names
+            .iter()
+            .map(|name| (name.to_string(), "synthetic-marker".into()))
+            .collect::<Vec<_>>();
+        let mut script = String::from("IFS= read -r request || exit 1; ");
+        for name in names {
+            script.push_str(&format!("test -z \"${{{name}+present}}\" || exit 2; "));
+        }
+        script.push_str("printf '%s\\n' '{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":1,\"agentInfo\":{\"name\":\"isolated-fixture\",\"version\":\"1\"},\"agentCapabilities\":{}}}'; while IFS= read -r ignored; do :; done");
+        let mut client = AcpClient::spawn_with_policy(
+            "/bin/sh",
+            &["-c".into(), script],
+            &extra,
+            false,
+            &extra,
+            false,
+            true,
+        )
+        .await
+        .unwrap();
+        let result =
+            tokio::time::timeout(std::time::Duration::from_secs(3), client.initialize()).await;
+        client.shutdown().await;
+        assert_eq!(
