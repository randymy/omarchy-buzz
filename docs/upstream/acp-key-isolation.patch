diff --git a/crates/buzz-acp/src/key_input.rs b/crates/buzz-acp/src/key_input.rs
new file mode 100644
index 0000000..a3c3365
--- /dev/null
+++ b/crates/buzz-acp/src/key_input.rs
@@ -0,0 +1,206 @@
+//! Bounded, one-shot relay key input from an inherited Linux pipe.
+
+#[cfg(target_os = "linux")]
+mod linux {
+    use nix::errno::Errno;
+    use nix::libc;
+    use nix::poll::{PollFd, PollFlags, PollTimeout, poll};
+    use nostr::Keys;
+    use std::fs::{self, File, OpenOptions};
+    use std::io::Read;
+    use std::os::fd::{AsFd, IntoRawFd, OwnedFd};
+    use std::os::unix::fs::{FileTypeExt, OpenOptionsExt};
+    use std::time::{Duration, Instant};
+    use zeroize::Zeroizing;
+
+    const MAX_KEY_BYTES: usize = 128;
+    const INPUT_DEADLINE: Duration = Duration::from_secs(3);
+
+    // The caller transfers exclusive ownership of a raw descriptor. Keep the
+    // original closed on every path, including failures before opening a File.
+    struct CloseOriginal(Option<i32>);
+
+    impl Drop for CloseOriginal {
+        fn drop(&mut self) {
+            if let Some(fd) = self.0.take() {
+                let _ = nix::unistd::close(fd);
+            }
+        }
+    }
+
+    /// Consume a Linux anonymous pipe descriptor. It is closed on every exit.
+    pub(crate) fn read_private_key(fd: i32) -> Result<Keys, &'static str> {
+        read_with_deadline(fd, INPUT_DEADLINE)
+    }
+
+    fn read_with_deadline(fd: i32, limit: Duration) -> Result<Keys, &'static str> {
+        // Never close stdin, stdout or stderr even if a caller passes one.
+        if fd < 3 {
+            return Err("private_key_fd_invalid");
+        }
+        let original = CloseOriginal(Some(fd));
+        let path = format!("/proc/self/fd/{fd}");
+        let target = fs::read_link(&path).map_err(|_| "private_key_fd_invalid")?;
+        if !target.to_string_lossy().starts_with("pipe:[") {
+            return Err("private_key_fd_not_pipe");
+        }
+        let mut info = String::new();
+        File::open(format!("/proc/self/fdinfo/{fd}"))
+            .map_err(|_| "private_key_fd_invalid")?
+            .take(4097)
+            .read_to_string(&mut info)
+            .map_err(|_| "private_key_fd_invalid")?;
+        if info.len() > 4096 {
+            return Err("private_key_fd_invalid");
+        }
+        let flags = info
+            .lines()
+            .find_map(|line| line.strip_prefix("flags:").map(str::trim))
+            .and_then(|value| i32::from_str_radix(value, 8).ok())
+            .ok_or("private_key_fd_invalid")?;
+        if flags & libc::O_ACCMODE != libc::O_RDONLY {
+            return Err("private_key_fd_not_read_end");
+        }
+        // Opening the proc descriptor produces a new owned File. O_NONBLOCK
+        // makes the deadline effective when the pipe writer stalls.
+        let mut input_file = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NONBLOCK | libc::O_CLOEXEC)
+            .open(&path)
+            .map_err(|_| "private_key_fd_invalid")?;
+        if !input_file
+            .metadata()
+            .map_err(|_| "private_key_fd_invalid")?
+            .file_type()
+            .is_fifo()
+        {
+            return Err("private_key_fd_not_pipe");
+        }
+        drop(original);
+
+        let deadline = Instant::now() + limit;
+        let mut input = Zeroizing::new([0u8; MAX_KEY_BYTES + 1]);
+        let mut length = 0usize;
+        loop {
+            if Instant::now() >= deadline {
+                return Err("private_key_fd_timeout");
+            }
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            let timeout_ms = remaining.as_millis().clamp(1, i32::MAX as u128) as i32;
+            let mut fds = [PollFd::new(
+                input_file.as_fd(),
+                PollFlags::POLLIN | PollFlags::POLLHUP,
+            )];
+            let timeout =
+                PollTimeout::try_from(timeout_ms).map_err(|_| "private_key_fd_read_failed")?;
+            match poll(&mut fds, timeout) {
+                Ok(0) => return Err("private_key_fd_timeout"),
+                Ok(_) => {}
+                Err(Errno::EINTR) => continue,
+                Err(_) => return Err("private_key_fd_read_failed"),
+            }
+            let events = fds[0].revents().ok_or("private_key_fd_read_failed")?;
+            if events.intersects(PollFlags::POLLERR | PollFlags::POLLNVAL) {
+                return Err("private_key_fd_read_failed");
+            }
+            // The extra byte distinguishes a full 128-byte input from overflow.
+            match input_file.read(&mut input[length..]) {
+                Ok(0) => {
+                    let text = std::str::from_utf8(&input[..length])
+                        .map_err(|_| "private_key_fd_invalid_key")?;
+                    return Keys::parse(text.trim()).map_err(|_| "private_key_fd_invalid_key");
+                }
+                Ok(count) => {
+                    length += count;
+                    if length > MAX_KEY_BYTES {
+                        return Err("private_key_fd_too_large");
+                    }
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => continue,
+                Err(_) => return Err("private_key_fd_read_failed"),
+            }
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use std::io::Write;
+        use std::os::fd::AsRawFd;
+
+        fn pipe() -> (OwnedFd, OwnedFd) {
+            nix::unistd::pipe().unwrap()
+        }
+
+        fn send(writer: OwnedFd, bytes: &[u8]) {
+            let mut file = File::from(writer);
+            file.write_all(bytes).unwrap();
+        }
+
+        #[test]
+        fn valid_pipe_key_is_consumed() {
+            let (read, write) = pipe();
+            let expected = Keys::generate();
+            send(
+                write,
+                format!("  {}\n", expected.secret_key().to_secret_hex()).as_bytes(),
+            );
+            let actual = read_private_key(read.into_raw_fd()).unwrap();
+            assert_eq!(actual.public_key(), expected.public_key());
+        }
+
+        #[test]
+        fn invalid_key_and_oversize_are_rejected() {
+            for (bytes, error) in [
+                (b"invalid".as_slice(), "private_key_fd_invalid_key"),
+                (&[b'x'; 129][..], "private_key_fd_too_large"),
+            ] {
+                let (read, write) = pipe();
+                send(write, bytes);
+                assert_eq!(read_private_key(read.into_raw_fd()).err(), Some(error));
+            }
+        }
+
+        #[test]
+        fn invalid_descriptors_are_rejected() {
+            assert_eq!(read_private_key(0).err(), Some("private_key_fd_invalid"));
+            assert_eq!(
+                read_private_key(i32::MAX).err(),
+                Some("private_key_fd_invalid")
+            );
+            let (_read, write) = pipe();
+            assert_eq!(
+                read_private_key(write.into_raw_fd()).err(),
+                Some("private_key_fd_not_read_end")
+            );
+        }
+
+        #[test]
+        fn regular_file_is_rejected() {
+            let file = tempfile::tempfile().unwrap();
+            assert!(file.as_raw_fd() >= 3);
+            assert_eq!(
+                read_private_key(file.into_raw_fd()).err(),
+                Some("private_key_fd_not_pipe")
+            );
+        }
+
+        #[test]
+        fn writer_without_eof_times_out() {
+            let (read, _write) = pipe();
+            assert_eq!(
+                read_with_deadline(read.into_raw_fd(), Duration::from_millis(30)).err(),
+                Some("private_key_fd_timeout")
+            );
+        }
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) use linux::read_private_key;
+
+#[cfg(not(target_os = "linux"))]
+pub(crate) fn read_private_key(_fd: i32) -> Result<nostr::Keys, &'static str> {
+    Err("private_key_fd_unsupported")
+}
