     #[tokio::test]
+    async fn authentication_can_wait_past_a_short_rpc_deadline() {
+        let script = r#"
+            read -t 2 _req
+            sleep 0.15
+            echo '{"jsonrpc":"2.0","id":0,"result":{}}'
+        "#;
+        let mut ordinary = spawn_script(script).await;
+        let short = std::time::Duration::from_millis(30);
+        let early = ordinary
+            .send_request_with_timeout("test/probe", serde_json::json!({}), short)
+            .await;
+        ordinary.shutdown().await;
+        assert!(matches!(early, Err(AcpError::Timeout(d)) if d == short));
+
+        let mut client = spawn_script(script).await;
+        let result = client
+            .authenticate_with_timeout("browser", std::time::Duration::from_secs(2))
+            .await;
+        client.shutdown().await;
+        assert!(result.is_ok(), "delayed auth response should succeed: {result:?}");
+    }
