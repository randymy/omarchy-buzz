+/// Only ACP `agent` auth methods may receive an `authenticate` request.
+/// An absent type defaults to `agent` per ACP. `terminal` methods require a
+/// separate interactive process. Reject malformed and duplicate IDs fail closed.
+fn validate_authenticate_method(
+    init_result: &serde_json::Value,
+    method_id: &str,
+) -> std::result::Result<(), &'static str> {
+    let mut matches = init_result
+        .get("authMethods")
+        .and_then(serde_json::Value::as_array)
+        .into_iter()
+        .flatten()
+        .filter(|method| method.get("id").and_then(serde_json::Value::as_str) == Some(method_id));
+    let Some(method) = matches.next() else {
+        return Err("method is not advertised by this adapter");
+    };
+    if matches.next().is_some() {
+        return Err("method ID is advertised more than once");
+    }
+    match method.get("type") {
+        None => Ok(()), // ACP defaults an absent type to `agent`.
+        Some(serde_json::Value::String(method_type)) if method_type == "agent" => Ok(()),
+        Some(serde_json::Value::String(method_type)) if method_type == "terminal" => {
+            Err("terminal authentication requires an interactive flow")
+        }
+        _ => Err("unsupported authentication method type"),
+    }
+}
