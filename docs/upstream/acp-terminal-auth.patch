+#[cfg(test)]
+mod auth_method_tests {
+    use super::validate_authenticate_method;
+    use serde_json::json;
+
+    #[test]
+    fn only_an_unambiguous_agent_method_can_use_acp_authenticate() {
+        let init = json!({"authMethods": [
+            {"id": "agent-login", "type": "agent"},
+            {"id": "terminal-login", "type": "terminal", "args": ["login"]},
+            {"id": "future-login", "type": "future"},
+            {"id": "untyped-login"},
+            {"id": "null-login", "type": null},
+            {"id": "number-login", "type": 1},
+            {"id": "duplicate", "type": "agent"},
+            {"id": "duplicate", "type": "terminal"}
+        ]});
+        assert_eq!(validate_authenticate_method(&init, "agent-login"), Ok(()));
+        assert_eq!(
+            validate_authenticate_method(&init, "terminal-login"),
+            Err("terminal authentication requires an interactive flow")
+        );
+        assert_eq!(
+            validate_authenticate_method(&init, "future-login"),
+            Err("unsupported authentication method type")
+        );
+        assert_eq!(validate_authenticate_method(&init, "untyped-login"), Ok(()));
+        assert_eq!(
+            validate_authenticate_method(&init, "null-login"),
+            Err("unsupported authentication method type")
+        );
+        assert_eq!(
+            validate_authenticate_method(&init, "number-login"),
+            Err("unsupported authentication method type")
+        );
+        assert_eq!(
+            validate_authenticate_method(&init, "duplicate"),
+            Err("method ID is advertised more than once")
+        );
+        assert_eq!(
+            validate_authenticate_method(&init, "missing"),
+            Err("method is not advertised by this adapter")
+        );
+        assert_eq!(
+            validate_authenticate_method(&json!({"authMethods": "malformed"}), "agent-login"),
+            Err("method is not advertised by this adapter")
+        );
+    }
+}
