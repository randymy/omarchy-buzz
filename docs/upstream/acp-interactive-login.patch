+//! Restricted interactive authentication. Never run this from the QML process.
+use serde_json::Value;
+use std::{
+    path::{Path, PathBuf},
+    time::Duration,
+};
+
+pub enum AuthPlan {
+    Agent,
+    Terminal {
+        args: Vec<String>,
+        interactive_env: bool,
+    },
+}
+
+pub fn select(methods: &[Value], id: &str) -> Result<AuthPlan, &'static str> {
+    if methods.len() > 64 || id.is_empty() || id.len() > 128 {
+        return Err("auth_method_invalid");
+    }
+    let mut matches = methods
+        .iter()
+        .filter(|m| m.get("id").and_then(Value::as_str) == Some(id));
+    let method = matches.next().ok_or("auth_method_unavailable")?;
+    if matches.next().is_some() {
+        return Err("auth_method_ambiguous");
+    }
+    match method.get("type") {
+        None => Ok(AuthPlan::Agent),
+        Some(Value::String(kind)) if kind == "agent" => Ok(AuthPlan::Agent),
+        Some(Value::String(kind)) if kind == "terminal" => {
+            if method.get("command").is_some() {
+                return Err("auth_command_forbidden");
+            }
+            let values = method
+                .get("args")
+                .and_then(Value::as_array)
+                .ok_or("auth_args_invalid")?;
+            if values.is_empty() || values.len() > 32 {
+                return Err("auth_args_invalid");
+            }
+            let mut args = Vec::new();
+            let mut bytes = 0;
+            for value in values {
+                let arg = value.as_str().ok_or("auth_args_invalid")?;
+                bytes += arg.len();
+                if arg.len() > 4096 || bytes > 8192 || arg.chars().any(char::is_control) {
+                    return Err("auth_args_invalid");
+                }
+                args.push(arg.to_owned());
+            }
+            // A restricted subset: never allow adapter-controlled PATH, loaders,
+            // provider keys, config overrides or arbitrary executable selection.
+            let interactive_env = match method.get("env") {
+                None => false,
+                Some(Value::Object(env)) if env.is_empty() => false,
+                Some(Value::Object(env))
+                    if env.len() == 1
+                        && env.get("ACP_INTERACTIVE_LOGIN").and_then(Value::as_str)
+                            == Some("1") =>
+                {
+                    true
+                }
+                _ => return Err("auth_env_unsupported"),
+            };
+            Ok(AuthPlan::Terminal {
+                args,
+                interactive_env,
+            })
+        }
+        _ => Err("auth_type_unsupported"),
+    }
+}
+
+// Used for discovery, interactive login and reconnect alike. Provider login
+// stores remain native; filtering environment alone does not prove billing mode.
+pub fn environment() -> Vec<(std::ffi::OsString, std::ffi::OsString)> {
+    const ALLOWED: &[&str] = &[
+        "HOME",
+        "PATH",
+        "LANG",
+        "LC_ALL",
+        "TERM",
+        "COLORTERM",
+        "XDG_CONFIG_HOME",
+        "XDG_DATA_HOME",
+        "XDG_STATE_HOME",
+        "XDG_RUNTIME_DIR",
+        "DBUS_SESSION_BUS_ADDRESS",
+        "DISPLAY",
+        "WAYLAND_DISPLAY",
+    ];
+    ALLOWED
+        .iter()
+        .filter_map(|name| std::env::var_os(name).map(|value| ((*name).into(), value)))
+        .collect()
+}
+
+pub fn resolve_program(command: &str) -> Result<PathBuf, &'static str> {
+    let candidates =
+        if Path::new(command).components().count() > 1 || Path::new(command).is_absolute() {
+            vec![PathBuf::from(command)]
+        } else {
+            std::env::split_paths(&std::env::var_os("PATH").unwrap_or_default())
+                .map(|p| p.join(command))
+                .collect()
+        };
+    for path in candidates {
+        if let Ok(path) = path.canonicalize() {
+            if path.is_file() {
+                #[cfg(unix)]
+                {
+                    use std::os::unix::fs::PermissionsExt;
+                    if path
+                        .metadata()
+                        .map(|m| m.permissions().mode() & 0o111 != 0)
+                        .unwrap_or(false)
+                    {
+                        return Ok(path);
+                    }
+                }
+            }
+        }
+    }
+    Err("auth_program_unavailable")
+}
+
+#[cfg(unix)]
+mod unix {
+    use super::*;
+    use nix::{
+        sys::{
+            signal::{killpg, pthread_sigmask, SigSet, SigmaskHow, Signal},
+            termios::{tcgetattr, tcsetattr, SetArg, Termios},
+        },
+        unistd::{getpgrp, tcgetpgrp, tcsetpgrp, Pid},
+    };
+    use std::{fs::File, io::IsTerminal, process::Stdio};
+
+    fn foreground(tty: &File, group: Pid) -> Result<(), &'static str> {
+        // Only this synchronous syscall sequence changes the thread signal mask.
+        let mut blocked = SigSet::empty();
+        blocked.add(Signal::SIGTTOU);
+        let mut previous = SigSet::empty();
+        pthread_sigmask(SigmaskHow::SIG_BLOCK, Some(&blocked), Some(&mut previous))
+            .map_err(|_| "auth_terminal_unavailable")?;
+        let result = tcsetpgrp(tty, group);
+        let restored = pthread_sigmask(SigmaskHow::SIG_SETMASK, Some(&previous), None);
+        result
+            .and(restored)
+            .map_err(|_| "auth_terminal_unavailable")
+    }
+    struct Terminal {
+        tty: File,
+        original_group: Pid,
+        original_mode: Termios,
+        child_group: Option<Pid>,
+    }
+    impl Terminal {
+        fn open() -> Result<Self, &'static str> {
+            if !std::io::stdin().is_terminal()
+                || !std::io::stdout().is_terminal()
+                || !std::io::stderr().is_terminal()
+            {
+                return Err("auth_terminal_required");
+            }
+            let tty = File::options()
+                .read(true)
+                .write(true)
+                .open("/dev/tty")
+                .map_err(|_| "auth_terminal_required")?;
+            let original_group = tcgetpgrp(&tty).map_err(|_| "auth_terminal_required")?;
+            if original_group != getpgrp() {
+                return Err("auth_foreground_required");
+            }
+            let original_mode = tcgetattr(&tty).map_err(|_| "auth_terminal_required")?;
+            Ok(Self {
+                tty,
+                original_group,
+                original_mode,
+                child_group: None,
+            })
+        }
+    }
+    impl Drop for Terminal {
+        fn drop(&mut self) {
+            if let Some(group) = self.child_group {
+                let _ = killpg(group, Signal::SIGKILL);
+            }
+            let _ = foreground(&self.tty, self.original_group);
+            let _ = tcsetattr(&self.tty, SetArg::TCSANOW, &self.original_mode);
+        }
+    }
+    pub fn available() -> bool {
+        Terminal::open().is_ok()
+    }
+    pub async fn run(
+        program: &Path,
+        base: &[String],
+        args: &[String],
+        interactive_env: bool,
+        limit: Duration,
+    ) -> Result<(), &'static str> {
+        let mut terminal = Terminal::open()?;
+        let mut terminate =
+            tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
+                .map_err(|_| "auth_signal_unavailable")?;
+        let mut hangup = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::hangup())
+            .map_err(|_| "auth_signal_unavailable")?;
+        let mut command = tokio::process::Command::new(program);
+        command
+            .args(base)
+            .args(args)
+            .env_clear()
+            .envs(environment())
+            .stdin(Stdio::from(
+                terminal
+                    .tty
+                    .try_clone()
+                    .map_err(|_| "auth_terminal_unavailable")?,
+            ))
+            .stdout(Stdio::from(
+                terminal
+                    .tty
+                    .try_clone()
+                    .map_err(|_| "auth_terminal_unavailable")?,
+            ))
+            .stderr(Stdio::from(
+                terminal
+                    .tty
+                    .try_clone()
+                    .map_err(|_| "auth_terminal_unavailable")?,
+            ))
+            .process_group(0)
+            .kill_on_drop(true);
+        if interactive_env {
+            command.env("ACP_INTERACTIVE_LOGIN", "1");
+        }
+        let mut child = command.spawn().map_err(|_| "auth_spawn_failed")?;
+        let group = Pid::from_raw(child.id().ok_or("auth_spawn_failed")? as i32);
+        terminal.child_group = Some(group);
+        if let Err(error) = foreground(&terminal.tty, group) {
+            drop(terminal);
+            let _ = tokio::time::timeout(Duration::from_secs(5), child.wait()).await;
+            return Err(error);
+        }
+        // A child which read stdin before the foreground handoff may be stopped.
+        let _ = killpg(group, Signal::SIGCONT);
+        let result = tokio::select! {
+            result=child.wait()=>match result {
+                Ok(status) if status.success()=>Ok(()),
+                _=>Err("auth_login_failed"),
+            },
+            _=tokio::time::sleep(limit)=>Err("auth_login_timeout"),
+            _=terminate.recv()=>Err("auth_login_cancelled"),
+            _=hangup.recv()=>Err("auth_login_cancelled"),
+            _=tokio::signal::ctrl_c()=>Err("auth_login_cancelled"),
+        };
+        drop(terminal); // Restore terminal and terminate remaining group members.
+        let _ = tokio::time::timeout(Duration::from_secs(5), child.wait()).await;
+        result
+    }
+}
+#[cfg(unix)]
+pub use unix::{available, run};
+#[cfg(not(unix))]
+pub fn available() -> bool {
+    false
+}
+#[cfg(not(unix))]
+pub async fn run(
+    _: &Path,
+    _: &[String],
+    _: &[String],
+    _: bool,
+    _: Duration,
+) -> Result<(), &'static str> {
+    Err("auth_platform_unsupported")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn method_types_and_argument_limits_fail_closed() {
+        assert!(matches!(
+            select(&[json!({"id":"x"})], "x"),
+            Ok(AuthPlan::Agent)
+        ));
+        for kind in [json!(null), json!(true), json!("other")] {
+            assert!(select(&[json!({"id":"x","type":kind})], "x").is_err());
+        }
+        for args in [
+            json!([]),
+            json!([null]),
+            json!(["bad\nargument"]),
+            json!(["x".repeat(4097)]),
+            json!(vec!["x"; 33]),
+        ] {
+            assert!(select(&[json!({"id":"x","type":"terminal","args":args})], "x").is_err());
+        }
+        assert!(select(&vec![json!({"id":"x"}); 65], "x").is_err());
+        assert!(select(&[json!({"id":"x"})], "missing").is_err());
+    }
+    #[test]
+    fn descriptor_cannot_choose_program_or_credentials() {
+        for env in [
+            json!({"PATH":"/tmp"}),
+            json!({"OPENAI_API_KEY":"synthetic"}),
+            json!({"ACP_INTERACTIVE_LOGIN":"2"}),
+            json!(null),
+        ] {
+            assert!(select(
+                &[json!({"id":"x","type":"terminal","args":["--login"],"env":env})],
+                "x"
+            )
+            .is_err());
+        }
+        assert!(select(
+            &[json!({"id":"x","type":"terminal","args":["--login"],"command":"sh"})],
+            "x"
+        )
+        .is_err());
+        assert!(matches!(
+            select(
+                &[json!({"id":"x","type":"terminal","args":["--login"]})],
+                "x"
+            ),
+            Ok(AuthPlan::Terminal {
+                interactive_env: false,
+                ..
+            })
+        ));
+    }
+}
