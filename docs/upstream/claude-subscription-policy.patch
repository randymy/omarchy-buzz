diff --git c/src/subscription-policy.ts i/src/subscription-policy.ts
new file mode 100644
index 0000000..ba50854
--- /dev/null
+++ i/src/subscription-policy.ts
@@ -0,0 +1,70 @@
+import { isAbsolute } from "node:path";
+import { RequestError } from "@agentclientprotocol/sdk";
+import { resolveSettings, type AccountInfo } from "@anthropic-ai/claude-agent-sdk";
+import type { Settings } from "@anthropic-ai/claude-agent-sdk";
+
+export function requiresClaudeSubscription(): boolean {
+  return process.argv.includes("--require-claude-subscription");
+}
+
+export function subscriptionDenied(): never {
+  throw RequestError.authRequired(
+    { reason: "claude_subscription_route_unavailable" },
+    "Claude subscription route is unavailable.",
+  );
+}
+
+/** Positive SDK account allowlist; the SDK account read is cached per Query. */
+export function isSubscriptionAccount(account: AccountInfo | undefined): boolean {
+  return !!account && account.apiProvider === "firstParty" &&
+    typeof account.subscriptionType === "string" && account.subscriptionType.trim().length > 0 &&
+    !account.tokenSource && (account.apiKeySource === undefined || account.apiKeySource === "none");
+}
+
+const FORBIDDEN_ENV = new Set([
+  "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL",
+  "ANTHROPIC_BEDROCK_BASE_URL", "ANTHROPIC_VERTEX_BASE_URL", "ANTHROPIC_CUSTOM_HEADERS",
+  "ANTHROPIC_VERTEX_PROJECT_ID", "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN_FD",
+  "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_EXECUTABLE",
+  "CLAUDE_MODEL_CONFIG", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
+  "GOOGLE_APPLICATION_CREDENTIALS", "CLOUD_ML_REGION", "NODE_OPTIONS", "NODE_PATH",
+  "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY",
+]);
+
+export function validateSubscriptionEnvironment(env: NodeJS.ProcessEnv): void {
+  if (!env.CLAUDE_CONFIG_DIR || !isAbsolute(env.CLAUDE_CONFIG_DIR) ||
+      !env.HOME || !isAbsolute(env.HOME)) subscriptionDenied();
+  for (const key of FORBIDDEN_ENV) {
+    if (env[key]) subscriptionDenied();
+  }
+}
+
+/** An explicit child environment prevents unknown future ambient route vars. */
+export function subscriptionChildEnv(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+  const child: NodeJS.ProcessEnv = {};
+  for (const key of ["HOME", "USER", "LOGNAME", "PATH", "TMPDIR", "LANG", "LC_ALL",
+    "TERM", "CLAUDE_CONFIG_DIR", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME",
+    "XDG_STATE_HOME", "XDG_RUNTIME_DIR", "SSL_CERT_FILE", "SSL_CERT_DIR"]) {
+    if (env[key] !== undefined) child[key] = env[key];
+  }
+  return child;
+}
+
+/** Managed settings still apply when SDK settingSources is empty. */
+export async function checkSubscriptionSettings(cwd: string): Promise<void> {
+  try {
+    const resolved = await resolveSettings({ cwd, settingSources: [] });
+    validateSubscriptionSettings(resolved.effective);
+  } catch {
+    subscriptionDenied();
+  }
+}
+
+export function validateSubscriptionSettings(settings: Settings): void {
+  const values = settings as unknown as Record<string, unknown>;
+  if (settings.apiKeyHelper || Object.values(settings.env ?? {}).some(Boolean) ||
+      ["awsAuthRefresh", "awsCredentialExport", "modelOverrides"].some((key) =>
+        values[key] !== undefined && values[key] !== null)) {
+    subscriptionDenied();
+  }
+}
diff --git c/src/tests/subscription-policy.test.ts i/src/tests/subscription-policy.test.ts
new file mode 100644
index 0000000..2e22279
--- /dev/null
+++ i/src/tests/subscription-policy.test.ts
@@ -0,0 +1,61 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { AccountInfo, Settings } from "@anthropic-ai/claude-agent-sdk";
+import { ClaudeAcpAgent, type AcpClient } from "../acp-agent.js";
+import { isSubscriptionAccount, subscriptionChildEnv, validateSubscriptionEnvironment,
+  validateSubscriptionSettings } from "../subscription-policy.js";
+
+describe("opt-in Claude subscription admission policy", () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it("uses a positive first-party, plan and no-key account allowlist", () => {
+    const good = { apiProvider: "firstParty", subscriptionType: "pro", apiKeySource: "none" };
+    expect(isSubscriptionAccount(good as AccountInfo)).toBe(true);
+    expect(isSubscriptionAccount({ ...good, apiKeySource: undefined } as AccountInfo)).toBe(true);
+    for (const account of [undefined, { ...good, subscriptionType: "" },
+      { ...good, apiProvider: "bedrock" }, { ...good, tokenSource: "oauth" },
+      { ...good, apiKeySource: "ANTHROPIC_API_KEY" },
+      { ...good, apiKeySource: "apiKeyHelper" },
+      { ...good, apiKeySource: "future-unknown" }]) {
+      expect(isSubscriptionAccount(account as AccountInfo | undefined)).toBe(false);
+    }
+  });
+
+  it("rejects ambient route inputs and only forwards environment basics", () => {
+    const clean = { HOME: "/isolated", CLAUDE_CONFIG_DIR: "/isolated/claude" };
+    expect(() => validateSubscriptionEnvironment(clean)).not.toThrow();
+    for (const env of [{ ...clean, ANTHROPIC_API_KEY: "synthetic" },
+      { ...clean, CLAUDE_CODE_OAUTH_TOKEN: "synthetic" },
+      { ...clean, CLAUDE_CODE_USE_BEDROCK: "1" },
+      { ...clean, CLAUDE_CODE_EXECUTABLE: "/other/claude" },
+      { ...clean, HTTPS_PROXY: "https://elsewhere.invalid" }]) {
+      expect(() => validateSubscriptionEnvironment(env)).toThrow();
+    }
+    expect(subscriptionChildEnv({ ...clean, OTHER_SECRET: "synthetic" })).toEqual(clean);
+  });
+
+  it("rejects managed or project settings with keys or injected env", () => {
+    expect(() => validateSubscriptionSettings({} as Settings)).not.toThrow();
+    expect(() => validateSubscriptionSettings({ apiKeyHelper: "key-command" } as Settings))
+      .toThrow();
+    expect(() => validateSubscriptionSettings({ env: { ANTHROPIC_BASE_URL: "https://elsewhere.invalid" } } as Settings))
+      .toThrow();
+  });
+
+  it("rejects provider and imported-session methods before mutation", async () => {
+    const argv = process.argv;
+    process.argv = [...argv, "--require-claude-subscription"];
+    try {
+      const agent = new ClaudeAcpAgent({ sessionUpdate: vi.fn() } as unknown as AcpClient);
+      await expect(agent.authenticate({ methodId: "gateway" } as never)).rejects.toThrow();
+      await expect(agent.unstable_setProvider({} as never)).rejects.toThrow();
+      await expect(agent.unstable_disableProvider({} as never)).rejects.toThrow();
+      await expect(agent.resumeSession({} as never)).rejects.toThrow();
+      await expect(agent.loadSession({} as never)).rejects.toThrow();
+      await expect(agent.unstable_forkSession({} as never)).rejects.toThrow();
+      await expect(agent.steer({} as never)).rejects.toThrow();
+      await expect(agent.goal({} as never)).rejects.toThrow();
+    } finally {
+      process.argv = argv;
+    }
+  });
+});
