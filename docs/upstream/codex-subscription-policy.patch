diff --git c/src/SubscriptionPolicy.ts i/src/SubscriptionPolicy.ts
new file mode 100644
index 0000000..4125030
--- /dev/null
+++ i/src/SubscriptionPolicy.ts
@@ -0,0 +1,84 @@
+import path from "node:path";
+import type {CodexAppServerClient} from "./CodexAppServerClient";
+
+const DENIED = "subscription_policy_denied";
+
+export function subscriptionDenied(): never {
+    throw new Error(DENIED);
+}
+
+function record(value: unknown): Record<string, unknown> | null {
+    return value !== null && typeof value === "object" && !Array.isArray(value)
+        ? value as Record<string, unknown> : null;
+}
+
+/** Checks the supported config/read(cwd) surface, not a billing receipt. */
+export function validSubscriptionConfig(value: unknown): boolean {
+    const config = record(value);
+    if (!config || config["forced_login_method"] !== "chatgpt") return false;
+    if (config["model_provider"] !== null && config["model_provider"] !== undefined
+        && config["model_provider"] !== "openai") return false;
+    for (const key of ["openai_base_url", "chatgpt_base_url", "model_catalog_url",
+        "experimental_bearer_token"]) {
+        if (config[key] !== null && config[key] !== undefined) return false;
+    }
+    const providers = config["model_providers"];
+    const providerEntries = record(providers);
+    if (providers !== null && providers !== undefined
+        && (!providerEntries || Object.keys(providerEntries).length !== 0)) return false;
+    return true;
+}
+
+const FORBIDDEN_ENV = ["CODEX_PATH", "CODEX_CONFIG", "MODEL_PROVIDER", "DEFAULT_AUTH_REQUEST",
+    "OPENAI_API_KEY", "CODEX_API_KEY", "OPENAI_BASE_URL", "CHATGPT_BASE_URL",
+    "CODEX_BASE_URL", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NODE_OPTIONS", "NODE_PATH"];
+
+export function validateSubscriptionStartup(env: NodeJS.ProcessEnv): void {
+    if (!env["CODEX_HOME"] || !path.isAbsolute(env["CODEX_HOME"])) subscriptionDenied();
+    if (FORBIDDEN_ENV.some(key => env[key] !== undefined)) subscriptionDenied();
+}
+
+/** Only explicit process basics reach the native app-server in this mode. */
+export function subscriptionChildEnv(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+    const child: NodeJS.ProcessEnv = {};
+    for (const key of ["HOME", "USER", "LOGNAME", "PATH", "TMPDIR", "LANG", "LC_ALL",
+        "TERM", "CODEX_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME",
+        "XDG_STATE_HOME", "XDG_RUNTIME_DIR", "SSL_CERT_FILE", "SSL_CERT_DIR"]) {
+        if (env[key] !== undefined) child[key] = env[key];
+    }
+    return child;
+}
+
+export class SubscriptionPolicy {
+    private readonly sessions = new Map<string, string>();
+    private readonly native: CodexAppServerClient;
+
+    constructor(native: CodexAppServerClient) {
+        this.native = native;
+    }
+
+    async checkWorkspace(cwd: string): Promise<void> {
+        if (!cwd || !path.isAbsolute(cwd)) subscriptionDenied();
+        try {
+            const [config, account] = await Promise.all([
+                this.native.configRead({cwd, includeLayers: false}),
+                this.native.accountRead({refreshToken: false}),
+            ]);
+            if (!validSubscriptionConfig(config.config) || account.account?.type !== "chatgpt") {
+                subscriptionDenied();
+            }
+        } catch {
+            subscriptionDenied();
+        }
+    }
+
+    remember(sessionId: string, cwd: string): void {
+        this.sessions.set(sessionId, cwd);
+    }
+
+    async checkPrompt(sessionId: string): Promise<void> {
+        const cwd = this.sessions.get(sessionId);
+        if (!cwd) subscriptionDenied();
+        await this.checkWorkspace(cwd);
+    }
+}
