@@ -0,0 +1,93 @@
+import {describe, expect, it, vi} from "vitest";
+import type {CodexAppServerClient} from "../CodexAppServerClient";
+import {CodexAcpClient} from "../CodexAcpClient";
+import {CodexAcpServer} from "../CodexAcpServer";
+import {createCodexMockTestFixture} from "./acp-test-utils";
+import {PROTOCOL_VERSION} from "@agentclientprotocol/sdk";
+import {SubscriptionPolicy, subscriptionChildEnv, validSubscriptionConfig,
+    validateSubscriptionStartup} from "../SubscriptionPolicy";
+
+const cleanConfig = {forced_login_method: "chatgpt", model_provider: null};
+
+describe("opt-in ChatGPT subscription routing policy", () => {
+    it("rejects route-bearing effective config without exposing values", () => {
+        expect(validSubscriptionConfig(cleanConfig)).toBe(true);
+        for (const config of [
+            {...cleanConfig, forced_login_method: "api"},
+            {...cleanConfig, model_provider: "proxy"},
+            {...cleanConfig, openai_base_url: "https://elsewhere.invalid"},
+            {...cleanConfig, chatgpt_base_url: "https://elsewhere.invalid"},
+            {...cleanConfig, model_providers: {proxy: {base_url: "https://elsewhere.invalid"}}},
+        ]) expect(validSubscriptionConfig(config)).toBe(false);
+        expect(validSubscriptionConfig(null)).toBe(false);
+    });
+
+    it("requires a dedicated home and rejects ambient route inputs", () => {
+        expect(() => validateSubscriptionStartup({CODEX_HOME: "/isolated/codex"})).not.toThrow();
+        for (const env of [{}, {CODEX_HOME: "relative"},
+            {CODEX_HOME: "/isolated/codex", MODEL_PROVIDER: "proxy"},
+            {CODEX_HOME: "/isolated/codex", OPENAI_API_KEY: "synthetic"},
+        ]) expect(() => validateSubscriptionStartup(env)).toThrow("subscription_policy_denied");
+        expect(subscriptionChildEnv({CODEX_HOME: "/isolated/codex", HOME: "/isolated",
+            OTHER_TOKEN: "synthetic"})).toEqual({CODEX_HOME: "/isolated/codex", HOME: "/isolated"});
+    });
+
+    it("checks cwd-aware config and ChatGPT account at creation and before prompt", async () => {
+        const configRead = vi.fn().mockResolvedValue({config: cleanConfig});
+        const accountRead = vi.fn().mockResolvedValue({account: {type: "chatgpt"}});
+        const native = {configRead, accountRead} as unknown as CodexAppServerClient;
+        const policy = new SubscriptionPolicy(native);
+        await policy.checkWorkspace("/workspace");
+        expect(configRead).toHaveBeenCalledWith({cwd: "/workspace", includeLayers: false});
+        policy.remember("fresh", "/workspace");
+        await policy.checkPrompt("fresh");
+        expect(configRead).toHaveBeenCalledTimes(2);
+        await expect(policy.checkPrompt("imported")).rejects.toThrow("subscription_policy_denied");
+        accountRead.mockResolvedValue({account: {type: "apiKey"}});
+        await expect(policy.checkPrompt("fresh")).rejects.toThrow("subscription_policy_denied");
+    });
+
+    it("fails closed with a static error on native read failures", async () => {
+        const native = {configRead: vi.fn().mockRejectedValue(new Error("sensitive native failure")),
+            accountRead: vi.fn().mockResolvedValue({account: null})} as unknown as CodexAppServerClient;
+        await expect(new SubscriptionPolicy(native).checkWorkspace("/workspace"))
+            .rejects.toThrow("subscription_policy_denied");
+    });
+
+    it("pins the client provider and denies internal route and import methods", async () => {
+        const fixture = createCodexMockTestFixture();
+        const client = new CodexAcpClient(fixture.getCodexAppServerClient(), {}, undefined, true);
+        expect(client.getModelProvider()).toBe("openai");
+        expect(() => client.setProvider({providerId: "openai", apiType: "openai",
+            baseUrl: "https://elsewhere.invalid"})).toThrow("subscription_policy_denied");
+        expect(() => client.disableProvider({providerId: "openai"}))
+            .toThrow("subscription_policy_denied");
+        await expect(client.authenticate({methodId: "api-key"} as never))
+            .rejects.toThrow("subscription_policy_denied");
+        await expect(client.resumeSession({} as never)).rejects.toThrow("subscription_policy_denied");
+        await expect(client.forkSession({} as never)).rejects.toThrow("subscription_policy_denied");
+        await expect(client.loadSession({} as never)).rejects.toThrow("subscription_policy_denied");
+        await expect(client.newSession({cwd: "/workspace", mcpServers: [{}] as never}))
+            .rejects.toThrow("subscription_policy_denied");
+        await expect(client.newSession({cwd: "/workspace", mcpServers: [],
+            additionalDirectories: ["/other"]} as never))
+            .rejects.toThrow("subscription_policy_denied");
+    });
+
+    it("advertises only supported auth and fresh-session capabilities", async () => {
+        const fixture = createCodexMockTestFixture();
+        const client = new CodexAcpClient(fixture.getCodexAppServerClient(), {}, undefined, true);
+        const server = new CodexAcpServer(fixture.getAcpConnection(), client,
+            undefined, () => null, undefined, undefined, true);
+        const response = await server.initialize({protocolVersion: PROTOCOL_VERSION});
+        expect(response.authMethods?.every(method => method.id === "chat-gpt"
+            || method.id === "chat-gpt-device-code")).toBe(true);
+        expect(response.agentCapabilities?.providers).toBeUndefined();
+        expect(response.agentCapabilities?.loadSession).toBeUndefined();
+        expect(response.agentCapabilities?.sessionCapabilities?.resume).toBeUndefined();
+        expect(response.agentCapabilities?.sessionCapabilities?.fork).toBeUndefined();
+        expect(response.agentCapabilities?.sessionCapabilities?.additionalDirectories).toBeUndefined();
+        expect(response.agentCapabilities?.mcpCapabilities?.http).toBe(false);
+        expect(response._meta?.["steering"]).toBeUndefined();
+    });
+});
