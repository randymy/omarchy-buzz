+//! Bounded, turn-local collection of user-facing ACP message text.
+
+const MAX_REPLY_BYTES: usize = 64 * 1024;
+
+pub(crate) struct Capture {
+    session_id: String,
+    text: String,
+    failure: Option<&'static str>,
+}
+
+impl Capture {
+    pub(crate) fn new(session: &str) -> Self {
+        Self {
+            session_id: session.to_owned(),
+            text: String::new(),
+            failure: None,
+        }
+    }
+
+    pub(crate) fn observe(&mut self, message: &serde_json::Value) {
+        // Only ACP notifications can contribute text. A response or request with
+        // an id cannot be mistaken for an agent's user-facing message.
+        if message.get("jsonrpc").and_then(serde_json::Value::as_str) != Some("2.0")
+            || message.get("method").and_then(serde_json::Value::as_str) != Some("session/update")
+            || message.get("id").is_some()
+            || message
+                .pointer("/params/update/sessionUpdate")
+                .and_then(serde_json::Value::as_str)
+                != Some("agent_message_chunk")
+        {
+            return;
+        }
+
+        match message
+            .pointer("/params/sessionId")
+            .and_then(serde_json::Value::as_str)
+        {
+            Some(id) if id == self.session_id.as_str() => {}
+            Some(_) => return,
+            None => {
+                self.poison("malformed");
+                return;
+            }
+        }
+
+        let content = &message["params"]["update"]["content"];
+        match content.get("type").and_then(serde_json::Value::as_str) {
+            Some("text") => {}
+            Some(_) => return, // Images and other content blocks are unsupported.
+            None => {
+                self.poison("malformed");
+                return;
+            }
+        }
+        let Some(chunk) = content.get("text").and_then(serde_json::Value::as_str) else {
+            self.poison("malformed");
+            return;
+        };
+        if self.failure.is_some() {
+            return;
+        }
+        if chunk.len() > MAX_REPLY_BYTES.saturating_sub(self.text.len()) {
+            self.poison("too_large");
+            return;
+        }
+        self.text.push_str(chunk);
+    }
+
+    pub(crate) fn finish(self, completed: bool) -> Result<String, &'static str> {
+        if !completed {
+            return Err("cancelled");
+        }
+        if let Some(reason) = self.failure {
+            return Err(reason);
+        }
+        if self.text.trim().is_empty() {
+            return Err("empty");
+        }
+        Ok(self.text)
+    }
+
+    fn poison(&mut self, reason: &'static str) {
+        self.failure.get_or_insert(reason);
+        self.text.clear();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Capture, MAX_REPLY_BYTES};
+    use serde_json::{Value, json};
+
+    fn chunk(session: &str, content: Value) -> Value {
+        json!({
+            "jsonrpc": "2.0", "method": "session/update",
+            "params": {"sessionId": session, "update": {
+                "sessionUpdate": "agent_message_chunk", "content": content
+            }}
+        })
+    }
+
+    #[test]
+    fn matching_text_chunks_keep_wire_order() {
+        let mut capture = Capture::new("active");
+        capture.observe(&chunk("active", json!({"type": "text", "text": "Hello"})));
+        capture.observe(&chunk("active", json!({"type": "text", "text": ", "})));
+        capture.observe(&chunk("active", json!({"type": "text", "text": "world"})));
+        assert_eq!(capture.finish(true), Ok("Hello, world".to_owned()));
+    }
+
+    #[test]
+    fn other_sessions_and_non_notifications_are_ignored() {
+        let mut capture = Capture::new("active");
+        let foreign = chunk("other", json!({"type": "text", "text": "secret"}));
+        capture.observe(&foreign);
+        let mut with_id = chunk("active", json!({"type": "text", "text": "request"}));
+        with_id["id"] = json!(1);
+        capture.observe(&with_id);
+        let mut wrong_version = chunk("active", json!({"type": "text", "text": "old"}));
+        wrong_version["jsonrpc"] = json!("1.0");
+        capture.observe(&wrong_version);
+        capture.observe(&chunk("active", json!({"type": "text", "text": "yes"})));
+        assert_eq!(capture.finish(true), Ok("yes".to_owned()));
+    }
+
+    #[test]
+    fn missing_session_poison_clears_previous_text() {
+        let mut capture = Capture::new("active");
+        capture.observe(&chunk("active", json!({"type": "text", "text": "before"})));
+        let mut malformed = chunk("active", json!({"type": "text", "text": "bad"}));
+        malformed["params"]
+            .as_object_mut()
+            .unwrap()
+            .remove("sessionId");
+        capture.observe(&malformed);
+        capture.observe(&chunk("active", json!({"type": "text", "text": "after"})));
+        assert_eq!(capture.finish(true), Err("malformed"));
+    }
+
+    #[test]
+    fn thought_tool_and_nontext_content_are_not_copied() {
+        let mut capture = Capture::new("active");
+        let mut thought = chunk("active", json!({"type": "text", "text": "private"}));
+        thought["params"]["update"]["sessionUpdate"] = json!("agent_thought_chunk");
+        capture.observe(&thought);
+        let mut tool = thought.clone();
+        tool["params"]["update"]["sessionUpdate"] = json!("tool_call_update");
+        capture.observe(&tool);
+        capture.observe(&chunk("active", json!({"type": "image", "data": "hidden"})));
+        capture.observe(&chunk("active", json!({"type": "text", "text": "public"})));
+        assert_eq!(capture.finish(true), Ok("public".to_owned()));
+    }
+
+    #[test]
+    fn malformed_text_poison_clears_previous_text() {
+        let mut capture = Capture::new("active");
+        capture.observe(&chunk("active", json!({"type": "text", "text": "before"})));
+        capture.observe(&chunk("active", json!({"type": "text", "text": 7})));
+        assert_eq!(capture.finish(true), Err("malformed"));
+    }
+
+    #[test]
+    fn byte_limit_includes_multibyte_utf8() {
+        let mut exact = Capture::new("active");
+        exact.observe(&chunk(
+            "active",
+            json!({"type": "text", "text": "é".repeat(MAX_REPLY_BYTES / 2)}),
+        ));
+        assert_eq!(exact.finish(true).unwrap().len(), MAX_REPLY_BYTES);
+
+        let mut overflow = Capture::new("active");
+        overflow.observe(&chunk(
+            "active",
+            json!({"type": "text", "text": "x".repeat(MAX_REPLY_BYTES - 1)}),
+        ));
+        overflow.observe(&chunk("active", json!({"type": "text", "text": "é"})));
+        overflow.observe(&chunk("active", json!({"type": "text", "text": "after"})));
+        assert_eq!(overflow.finish(true), Err("too_large"));
+    }
+
+    #[test]
+    fn empty_and_cancelled_turns_have_distinct_results() {
+        assert_eq!(Capture::new("active").finish(true), Err("empty"));
+        let mut capture = Capture::new("active");
+        capture.observe(&chunk("active", json!({"type": "text", "text": "partial"})));
+        assert_eq!(capture.finish(false), Err("cancelled"));
+    }
+}
