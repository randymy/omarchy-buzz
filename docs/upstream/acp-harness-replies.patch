+// Bound background reply submissions even when synthetic peers complete instantly.
+static ROOM_REPLY_SLOTS: tokio::sync::Semaphore = tokio::sync::Semaphore::const_new(8);
+
+fn spawn_room_reply(
+    rest: relay::RestClient,
+    reply: room_reply::Ready,
+    observer: Option<observer::ObserverHandle>,
+    agent_index: usize,
+    turn_id: String,
+) {
+    let context = observer::context_for_turn(
+        Some(reply.target.channel_id),
+        None,
+        turn_id.clone(),
+        chrono::Utc::now().to_rfc3339(),
+    );
+    let Ok(permit) = ROOM_REPLY_SLOTS.try_acquire() else {
+        if let Some(observer) = &observer {
+            observer.emit(
+                "room_reply_submission",
+                Some(agent_index),
+                &context,
+                serde_json::json!({"status": "not_sent", "reason": "publisher_busy"}),
+            );
+        }
+        tracing::warn!("room reply not submitted: publisher busy");
+        return;
+    };
+    tokio::spawn(async move {
+        let _permit = permit;
+        let channel = reply.target.channel_id;
+        let Ok(event) = reply.sign(&rest.keys) else {
+            if let Some(observer) = &observer {
+                observer.emit(
+                    "room_reply_submission",
+                    Some(agent_index),
+                    &context,
+                    serde_json::json!({"status": "not_sent", "reason": "invalid_reply"}),
+                );
+            }
+            tracing::warn!("room reply not submitted: invalid reply");
+            return;
+        };
+        let status = rest.submit_room_reply_once(&event).await;
+        tracing::info!(event_id = %event.id, status, "room reply submission result");
+        if let Some(observer) = observer {
+            observer.emit(
+                "room_reply_submission",
+                Some(agent_index),
+                &observer::context_for_turn(
+                    Some(channel),
+                    None,
+                    turn_id,
+                    chrono::Utc::now().to_rfc3339(),
+                ),
+                serde_json::json!({"eventId": event.id.to_hex(), "status": status}),
+            );
+        }
+    });
+}
