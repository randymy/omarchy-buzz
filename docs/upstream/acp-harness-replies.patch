+//! Trusted thread destinations and relay acknowledgment classification.
+
+use crate::scope::SessionScope;
+use uuid::Uuid;
+
+const MAX_REPLY_BYTES: usize = 64 * 1024;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Target {
+    pub channel_id: Uuid,
+    pub root_event_id: nostr::EventId,
+}
+
+impl Target {
+    pub(crate) fn from_scope(scope: &SessionScope) -> Result<Self, &'static str> {
+        let SessionScope::Thread {
+            channel_id,
+            root_event_id,
+        } = scope
+        else {
+            return Err("unsupported_scope");
+        };
+        let root = nostr::EventId::from_hex(root_event_id).map_err(|_| "invalid_root")?;
+        if root.to_hex() != *root_event_id {
+            return Err("invalid_root");
+        }
+        Ok(Self {
+            channel_id: *channel_id,
+            root_event_id: root,
+        })
+    }
+
+    pub(crate) fn matches_scope(&self, scope: &SessionScope) -> bool {
+        Self::from_scope(scope).is_ok_and(|target| target == *self)
+    }
+}
+
+pub(crate) struct Ready {
+    pub target: Target,
+    pub text: String,
+}
+
+impl Ready {
+    pub(crate) fn sign(&self, keys: &nostr::Keys) -> Result<nostr::Event, &'static str> {
+        if self.text.trim().is_empty() {
+            return Err("empty");
+        }
+        if self.text.len() > MAX_REPLY_BYTES {
+            return Err("too_large");
+        }
+        let thread = buzz_sdk::ThreadRef {
+            root_event_id: self.target.root_event_id,
+            parent_event_id: self.target.root_event_id,
+        };
+        buzz_sdk::build_message(
+            self.target.channel_id,
+            &self.text,
+            Some(&thread),
+            &[],
+            false,
+            &[],
+            &[],
+        )
+        .map_err(|_| "build_failed")?
+        .sign_with_keys(keys)
+        .map_err(|_| "sign_failed")
+    }
+}
+
+/// A duplicate response is ambiguous because it does not prove that this
+/// submission created the event. Callers must retain the signed event ID.
+pub(crate) fn classify_ack(expected: &nostr::EventId, ack: &serde_json::Value) -> &'static str {
+    if ack.get("event_id").and_then(serde_json::Value::as_str) != Some(expected.to_hex().as_str()) {
+        return "delivery_unknown";
+    }
+    match ack.get("accepted").and_then(serde_json::Value::as_bool) {
+        Some(true) => "accepted",
+        Some(false)
+            if ack
+                .get("message")
+                .and_then(serde_json::Value::as_str)
+                .is_some_and(|message| message.starts_with("duplicate:")) =>
+        {
+            "delivery_unknown"
+        }
+        Some(false) => "rejected",
+        None => "delivery_unknown",
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{MAX_REPLY_BYTES, Ready, Target, classify_ack};
+    use crate::scope::SessionScope;
+    use nostr::{EventId, Keys, Kind};
+    use serde_json::json;
+    use uuid::Uuid;
+
+    fn scope(channel_id: Uuid, root: &str) -> SessionScope {
+        SessionScope::Thread {
+            channel_id,
+            root_event_id: root.to_owned(),
+        }
+    }
+
+    fn root() -> EventId {
+        EventId::from_hex(&"ab".repeat(32)).unwrap()
+    }
+
+    #[test]
+    fn target_accepts_only_canonical_thread_scope() {
+        let channel = Uuid::new_v4();
+        let valid = scope(channel, &root().to_hex());
+        let target = Target::from_scope(&valid).unwrap();
+        assert_eq!(target.channel_id, channel);
+        assert_eq!(target.root_event_id, root());
+        assert!(target.matches_scope(&valid));
+        assert!(!target.matches_scope(&scope(Uuid::new_v4(), &root().to_hex())));
+        assert!(!target.matches_scope(&scope(channel, &"cd".repeat(32))));
+        assert_eq!(
+            Target::from_scope(&scope(channel, "invalid")),
+            Err("invalid_root")
+        );
+        assert_eq!(
+            Target::from_scope(&scope(channel, &"AB".repeat(32))),
+            Err("invalid_root")
+        );
+        assert_eq!(
+            Target::from_scope(&SessionScope::Conversation {
+                channel_id: channel
+            }),
+            Err("unsupported_scope")
+        );
+    }
+
+    #[test]
+    fn signed_reply_uses_public_author_and_flat_thread_tags() {
+        let keys = Keys::generate();
+        let channel = Uuid::new_v4();
+        let event = Ready {
+            target: Target::from_scope(&scope(channel, &root().to_hex())).unwrap(),
+            text: "A reply".to_owned(),
+        }
+        .sign(&keys)
+        .unwrap();
+        event.verify().unwrap();
+        assert_eq!(event.kind, Kind::Custom(9));
+        assert_eq!(event.pubkey, keys.public_key());
+        assert_eq!(event.content, "A reply");
+        let tags: Vec<&[String]> = event.tags.iter().map(|tag| tag.as_slice()).collect();
+        assert_eq!(tags.len(), 2);
+        assert!(tags.contains(&["h".to_owned(), channel.to_string()].as_slice()));
+        assert!(
+            tags.contains(
+                &[
+                    "e".to_owned(),
+                    root().to_hex(),
+                    String::new(),
+                    "reply".to_owned()
+                ]
+                .as_slice()
+            )
+        );
+    }
+
+    #[test]
+    fn signing_rejects_empty_and_excess_utf8_bytes() {
+        let keys = Keys::generate();
+        let target = Target::from_scope(&scope(Uuid::new_v4(), &root().to_hex())).unwrap();
+        for text in [String::new(), "   ".to_owned()] {
+            assert!(matches!(
+                Ready {
+                    target: target.clone(),
+                    text
+                }
+                .sign(&keys),
+                Err("empty")
+            ));
+        }
+        assert!(matches!(
+            Ready {
+                target: target.clone(),
+                text: "é".repeat(MAX_REPLY_BYTES / 2 + 1),
+            }
+            .sign(&keys),
+            Err("too_large")
+        ));
+        assert!(
+            Ready {
+                target,
+                text: "é".repeat(MAX_REPLY_BYTES / 2),
+            }
+            .sign(&keys)
+            .is_ok()
+        );
+    }
+
+    #[test]
+    fn ack_requires_exact_event_id_and_boolean_result() {
+        let id = root();
+        let matching = id.to_hex();
+        assert_eq!(
+            classify_ack(&id, &json!({"event_id": matching, "accepted": true})),
+            "accepted"
+        );
+        assert_eq!(
+            classify_ack(
+                &id,
+                &json!({"event_id": id.to_hex(), "accepted": false, "message": "denied"})
+            ),
+            "rejected"
+        );
+        assert_eq!(
+            classify_ack(
+                &id,
+                &json!({"event_id": id.to_hex(), "accepted": false, "message": "duplicate: stored"})
+            ),
+            "delivery_unknown"
+        );
+        assert_eq!(
+            classify_ack(&id, &json!({"event_id": "wrong", "accepted": true})),
+            "delivery_unknown"
+        );
+        assert_eq!(
+            classify_ack(&id, &json!({"event_id": id.to_hex(), "accepted": "true"})),
+            "delivery_unknown"
+        );
+        assert_eq!(
+            classify_ack(&id, &json!({"accepted": true})),
+            "delivery_unknown"
+        );
+        assert_eq!(
+            classify_ack(&id, &serde_json::Value::Null),
+            "delivery_unknown"
+        );
+    }
+}
