#!/bin/bash
set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
omarchy_source=${OMARCHY_SOURCE:-"$project_root/../omarchy"}
OMARCHY_SOURCE="$omarchy_source" "$project_root/scripts/validate"
command -v qs >/dev/null || { echo "preview: Quickshell is required" >&2; exit 1; }

# All Quickshell runtime/config files stay in a disposable test directory.
# Import real Omarchy UI components; this never starts the desktop shell.
preview_dir=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-buzz-preview.XXXXXXXX")
trap 'rm -rf -- "$preview_dir"' EXIT
mkdir -m 700 "$preview_dir/runtime"
mkdir -m 700 "$preview_dir/config"
cp -R "$project_root/plugin" "$preview_dir/plugin"
if [[ ${1:-} == --send-bridge ]]; then
  cp "$project_root/tests/SendBridge.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/send_bridge_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"sends":[],"fetches":0}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --thread-send ]]; then
  cp "$project_root/tests/ThreadSend.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --thread-replies ]]; then
  cp "$project_root/tests/ThreadReplies.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --live-updates ]]; then
  cp "$project_root/tests/LiveUpdates.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --catalog-refresh-send ]]; then
  cp "$project_root/tests/CatalogRefreshSend.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/catalog_refresh_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --new-dm ]]; then
  cp "$project_root/tests/NewDm.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/new_dm_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --onboarding ]]; then
  cp "$project_root/tests/Onboarding.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/onboarding_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --communities ]]; then
  cp "$project_root/tests/Communities.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/communities_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --welcome ]]; then
  # Synthetic helper and agent frames only. BUZZ_WELCOME_CAPTURE_DIR optionally
  # saves the welcome pane to welcome.png.
  cp "$project_root/tests/Welcome.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/welcome_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --invites ]]; then
  cp "$project_root/tests/Invites.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/invites_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --attachments ]]; then
  cp "$project_root/tests/Attachments.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/attachments_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --message-actions ]]; then
  cp "$project_root/tests/MessageActions.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/message_actions_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --status ]]; then
  cp "$project_root/tests/Status.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/status_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --presence ]]; then
  cp "$project_root/tests/Presence.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/presence_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --agents ]]; then
  cp "$project_root/tests/Agents.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/agents_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --older-history ]]; then
  cp "$project_root/tests/OlderHistory.qml" "$preview_dir/shell.qml"
  cp "$project_root/tests/older_history_fixture.py" "$preview_dir/helper-fixture"
  export BUZZ_TEST_HELPER="$preview_dir/helper-fixture"
  export BUZZ_SEND_RECORD="$preview_dir/send-record.json"
  printf '{"requests":[]}\n' > "$BUZZ_SEND_RECORD"
elif [[ ${1:-} == --last-room ]]; then
  cp "$project_root/tests/LastRoom.qml" "$preview_dir/shell.qml"
  export BUZZ_LAST_ROOM_PHASE=choose
elif [[ ${1:-} == --catalog-refresh ]]; then
  cp "$project_root/tests/CatalogRefresh.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --mentions ]]; then
  cp "$project_root/tests/Mentions.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --identicon ]]; then
  cp "$project_root/tests/Identicon.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --ansi-art ]]; then
  # Synthetic art only. BUZZ_ANSI_CAPTURE (an .ans path) and BUZZ_ANSI_CAPTURE_DIR
  # optionally render that art as my avatar to PNG files after the checks pass.
  cp "$project_root/tests/AnsiArt.qml" "$preview_dir/shell.qml"
  mkdir -m 700 "$preview_dir/files"
  cp "$project_root/tests/fixtures/avatar.ans" "$preview_dir/files/avatar.ans"
  head -c 270000 /dev/zero | tr '\0' x > "$preview_dir/files/large.ans"
  export BUZZ_ANSI_FIXTURE="$preview_dir/files/avatar.ans"
  export BUZZ_ANSI_LARGE="$preview_dir/files/large.ans"
elif [[ ${1:-} == --avatar-gallery ]]; then
  # Synthetic frames only. BUZZ_GALLERY_CAPTURE (a .png path) optionally saves the
  # gallery page, BUZZ_GALLERY_SHEET a contact sheet of every avatar, after the checks pass.
  cp "$project_root/tests/AvatarGallery.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --settings ]]; then
  # Synthetic frames only. BUZZ_SETTINGS_CAPTURE_DIR optionally saves the open
  # account menu and the settings view to PNG files after the checks pass.
  cp "$project_root/tests/Settings.qml" "$preview_dir/shell.qml"
  mkdir -m 700 "$preview_dir/files"
  cp "$project_root/tests/fixtures/avatar.ans" "$preview_dir/files/avatar.ans"
  export BUZZ_ANSI_FIXTURE="$preview_dir/files/avatar.ans"
elif [[ ${1:-} == --navigation ]]; then
  # Synthetic frames only. BUZZ_NAVIGATION_CAPTURE_DIR optionally saves the room
  # view and the agent editor with the header to PNG files after the checks pass.
  cp "$project_root/tests/Navigation.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --author-names ]]; then
  cp "$project_root/tests/AuthorNames.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --presentation ]]; then
  cp "$project_root/tests/Presentation.qml" "$preview_dir/shell.qml"
elif [[ ${1:-} == --activity ]]; then
  cp "$project_root/tests/Activity.qml" "$preview_dir/shell.qml"
  mkdir -m 700 "$preview_dir/fake-bin"
  printf '#!/bin/sh\nprintf "<%%s>\\n" "$@" >> "$BUZZ_ACTIVITY_RECORD"\n' > "$preview_dir/fake-bin/omarchy"
  chmod 700 "$preview_dir/fake-bin/omarchy"
  export BUZZ_ACTIVITY_RECORD="$preview_dir/activity-record"
  export PATH="$preview_dir/fake-bin:$PATH"
elif [[ ${1:-} == --room-activity ]]; then
  cp "$project_root/tests/RoomActivity.qml" "$preview_dir/shell.qml"
  mkdir -m 700 "$preview_dir/fake-bin"
  printf '#!/bin/sh\nprintf "<%%s>\\n" "$@" >> "$BUZZ_ACTIVITY_RECORD"\n' > "$preview_dir/fake-bin/omarchy"
  chmod 700 "$preview_dir/fake-bin/omarchy"
  export BUZZ_ACTIVITY_RECORD="$preview_dir/activity-record"
  export PATH="$preview_dir/fake-bin:$PATH"
elif [[ ${1:-} == --notifications ]]; then
  cp "$project_root/tests/Notifications.qml" "$preview_dir/shell.qml"
  mkdir -m 700 "$preview_dir/fake-bin"
  printf '#!/bin/sh\nprintf "<%%s>\\n" "$@" >> "$BUZZ_ACTIVITY_RECORD"\n' > "$preview_dir/fake-bin/omarchy"
  chmod 700 "$preview_dir/fake-bin/omarchy"
  export BUZZ_ACTIVITY_RECORD="$preview_dir/activity-record"
  export PATH="$preview_dir/fake-bin:$PATH"
elif [[ ${1:-} == --notification-preference ]]; then
  cp "$project_root/tests/NotificationPreference.qml" "$preview_dir/shell.qml"
  export BUZZ_PREFERENCE_PHASE=enable
elif [[ ${1:-} == --bridge ]]; then
  [[ -x ${BUZZ_TEST_HELPER:-} ]] || { echo "preview: set BUZZ_TEST_HELPER to a built helper" >&2; exit 1; }
  cp "$project_root/tests/Bridge.qml" "$preview_dir/shell.qml"
else
  cp "$project_root/tests/Preview.qml" "$preview_dir/shell.qml"
fi
ln -s "$omarchy_source/shell/Commons" "$preview_dir/Commons"
ln -s "$omarchy_source/shell/Ui" "$preview_dir/Ui"

preview_platform=offscreen
if [[ ${1:-} == --presentation ]]; then
  # The real PanelWindow backend requires Wayland. Show only a short-lived
  # synthetic view, with isolated config/state and no helper connection.
  [[ -n ${WAYLAND_DISPLAY:-} && -n ${XDG_RUNTIME_DIR:-} ]] || { echo "preview: presentation check requires Wayland" >&2; exit 1; }
  if [[ $WAYLAND_DISPLAY != /* ]]; then export WAYLAND_DISPLAY="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"; fi
  preview_platform=wayland
fi
QT_QPA_PLATFORM="$preview_platform" QT_QUICK_BACKEND=software QT_QPA_PLATFORMTHEME=basic \
  XDG_RUNTIME_DIR="$preview_dir/runtime" \
  XDG_CONFIG_HOME="$preview_dir/config" \
  XDG_STATE_HOME="$preview_dir/state" \
  timeout 15s qs -p "$preview_dir" --no-color
if [[ ${1:-} == --activity && -s $BUZZ_ACTIVITY_RECORD ]]; then
  echo "preview: baseline or own message triggered a notification" >&2
  exit 1
fi
if [[ ${1:-} == --room-activity ]]; then
  printf '<%s>\n' notification send --app-name Buzz -u normal -t 5000 Buzz \
    'New activity in your Buzz rooms.' > "$preview_dir/expected-activity-record"
  if ! cmp -s "$preview_dir/expected-activity-record" "$BUZZ_ACTIVITY_RECORD"; then
    echo "preview: expected one fixed-argument room activity notification" >&2
    exit 1
  fi
fi
if [[ ${1:-} == --notification-preference ]]; then
  preference_file="$preview_dir/state/omarchy-buzz/notifications.json"
  [[ $(cat "$preference_file") == '{"version":2,"mode":"all","text":false}' ]] || { echo "preview: notification choices were not saved" >&2; exit 1; }
  [[ $(stat -c %a "$preview_dir/state/omarchy-buzz") == 700 ]] || { echo "preview: notification state directory is not private" >&2; exit 1; }
  export BUZZ_PREFERENCE_PHASE=disable
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QT_QPA_PLATFORMTHEME=basic \
    XDG_RUNTIME_DIR="$preview_dir/runtime" XDG_CONFIG_HOME="$preview_dir/config" \
    XDG_STATE_HOME="$preview_dir/state" timeout 15s qs -p "$preview_dir" --no-color
  [[ $(cat "$preference_file") == '{"version":2,"mode":"none","text":true}' ]] || { echo "preview: notification opt-out was not saved" >&2; exit 1; }
  printf '{broken\n' > "$preference_file"
  export BUZZ_PREFERENCE_PHASE=invalid
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QT_QPA_PLATFORMTHEME=basic \
    XDG_RUNTIME_DIR="$preview_dir/runtime" XDG_CONFIG_HOME="$preview_dir/config" \
    XDG_STATE_HOME="$preview_dir/state" timeout 15s qs -p "$preview_dir" --no-color
  [[ $(cat "$preference_file") == '{broken' ]] || { echo "preview: invalid settings were overwritten without user action" >&2; exit 1; }
  # Version 1 only had on/off for general activity: on becomes "all", off stays off.
  for legacy in '{"version":1,"enabled":true}:legacy' '{"version":1,"enabled":false}:legacyoff'; do
    printf '%s\n' "${legacy%:*}" > "$preference_file"
    export BUZZ_PREFERENCE_PHASE=${legacy##*:}
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QT_QPA_PLATFORMTHEME=basic \
      XDG_RUNTIME_DIR="$preview_dir/runtime" XDG_CONFIG_HOME="$preview_dir/config" \
      XDG_STATE_HOME="$preview_dir/state" timeout 15s qs -p "$preview_dir" --no-color
  done
fi
if [[ ${1:-} == --notifications ]]; then
  # Rich notifications: titles, bodies, suppression, settings and click target.
  room_a=11111111-1111-4111-8111-111111111111
  room_b=22222222-2222-4222-8222-222222222222
  thread=$(printf 'c%.0s' {1..64})
  : > "$preview_dir/expected-notifications"
  expect() {
    printf '<%s>\n' notification send --app-name Buzz -u normal -t 8000 "$1" "$2" \
      --exec omarchy-shell -q shell summon community.buzz "$3" >> "$preview_dir/expected-notifications"
  }
  expect 'Alex mentioned you in #general' 'hi &lt;img src=http://x/y.png&gt; &amp; you' '{"room":"'$room_a'"}'
  expect ' -t replied in #general' ' --exec' '{"room":"'$room_a'","thread":"'$thread'"}'
  expect 'Alex in #general' 'New message from Alex' '{"room":"'$room_a'"}'
  expect 'Alex (direct message)' '2 new messages. Latest: yo' '{"room":"'$room_b'"}'
  expect 'Sam mentioned you in #general' 'ping' '{"room":"'$room_a'"}'
  expect 'Direct message' 'New message' '{"room":"'$room_b'"}'
  if ! cmp -s "$preview_dir/expected-notifications" "$BUZZ_ACTIVITY_RECORD"; then
    echo "preview: notification argv differs from the expected titles, bodies and click targets" >&2
    diff "$preview_dir/expected-notifications" "$BUZZ_ACTIVITY_RECORD" >&2 || true
    exit 1
  fi
  echo "PASS: notifications are titled by sender and room with escaped plain bodies, honour the mode and text settings, stay quiet for the open focused room, and click through to the room and thread"
fi
if [[ ${1:-} == --communities ]]; then
  # One remembered room per community (relay and identity), nothing else.
  view_file="$preview_dir/state/omarchy-buzz/view.json"
  [[ $(jq -c '.version' "$view_file") == 2 && $(jq -c '.rooms | keys | length' "$view_file") == 2 ]] || { echo "preview: per-community room memory not saved" >&2; exit 1; }
  [[ $(jq -r '.rooms["wss://first.example/|'"$(printf '6%.0s' {1..64})"'"]' "$view_file") == aaaaaaaa-0000-4000-8000-0000000000f2 ]] || { echo "preview: first community's room not remembered" >&2; exit 1; }
fi
if [[ ${1:-} == --presence ]]; then
  presence_file="$preview_dir/state/omarchy-buzz/presence.json"
  [[ $(jq -c . "$presence_file") == '{"version":1,"mode":"away"}' ]] || { echo "preview: presence preference was not saved" >&2; exit 1; }
fi
if [[ ${1:-} == --last-room ]]; then
  view_file="$preview_dir/state/omarchy-buzz/view.json"
  [[ $(jq -c 'keys' "$view_file") == '["rooms","version"]' && $(jq -c '.version' "$view_file") == 2 && $(jq -c '.rooms | keys' "$view_file") == '["wss://fixture.example/|'"$(printf 'b%.0s' {1..64})"'"]' ]] || { echo "preview: last room file holds unexpected fields" >&2; exit 1; }
  for phase in restore removed foreign; do
    export BUZZ_LAST_ROOM_PHASE=$phase
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QT_QPA_PLATFORMTHEME=basic \
      XDG_RUNTIME_DIR="$preview_dir/runtime" XDG_CONFIG_HOME="$preview_dir/config" \
      XDG_STATE_HOME="$preview_dir/state" timeout 15s qs -p "$preview_dir" --no-color
  done
  printf '{broken\n' > "$view_file"
  export BUZZ_LAST_ROOM_PHASE=invalid
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QT_QPA_PLATFORMTHEME=basic \
    XDG_RUNTIME_DIR="$preview_dir/runtime" XDG_CONFIG_HOME="$preview_dir/config" \
    XDG_STATE_HOME="$preview_dir/state" timeout 15s qs -p "$preview_dir" --no-color
  echo "PASS: last chosen room is restored within its relay and identity; removed rooms, other scopes and damaged files select the first room"
fi
if [[ ${1:-} == --activity ]]; then
  export BUZZ_ACTIVITY_POSITIVE=1
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QT_QPA_PLATFORMTHEME=basic \
    XDG_RUNTIME_DIR="$preview_dir/runtime" \
    XDG_CONFIG_HOME="$preview_dir/config" \
    XDG_STATE_HOME="$preview_dir/state" \
    timeout 15s qs -p "$preview_dir" --no-color
  printf '<%s>\n' notification send --app-name Buzz -u normal -t 5000 Buzz \
    'New activity in your Buzz rooms.' > "$preview_dir/expected-activity-record"
  if ! cmp -s "$preview_dir/expected-activity-record" "$BUZZ_ACTIVITY_RECORD"; then
    echo "preview: expected one fixed-argument notification for closed-panel activity" >&2
    exit 1
  fi
fi
