#!/usr/bin/env python3
"""Stage a permission-mode proposal; test its exact functions with transport doubles."""
import argparse
from pathlib import Path
import shutil
import subprocess

ROOT = Path(__file__).resolve().parents[1]
BASE = '781d39510cf23cfe224e8f521ae06a23377e06de'

def prepare(source, output):
    if output.exists() or output.is_symlink():
        raise ValueError('choose a new output directory')
    files = {name: subprocess.check_output(['git', 'show', BASE + ':crates/buzz-acp/src/' + name], cwd=source)
             for name in ('pool.rs', 'acp.rs')}
    output.mkdir(parents=True, mode=0o700)
    upstream = output / 'crates/buzz-acp/src'
    upstream.mkdir(parents=True)
    for name, data in files.items():
        (upstream / name).write_bytes(data)
    patch = ROOT / 'docs/upstream/acp-permission-mode.patch'
    subprocess.run(['git', 'apply', '--check', str(patch)], cwd=output, check=True)
    subprocess.run(['git', 'apply', str(patch)], cwd=output, check=True)
    pool = (upstream / 'pool.rs').read_text()
    client = (upstream / 'acp.rs').read_text()
    policy = pool[pool.index('fn agent_supports_mode('):pool.index('/// Prepend a legacy agent')]
    error = client[client.index('#[derive(Debug, thiserror::Error)]'):client.index('/// Build an [`AcpError::AgentError`]')]
    # Assert the extracted guard is actually wired into session preparation.
    start = pool.index('// An explicitly requested nondefault mode')
    setup = pool[start:pool.index('    Ok(resp.session_id)', start)]
    expected = '''if !ctx.permission_mode.is_default() {
        require_permission_mode(&resp.raw, ctx.permission_mode.as_wire_str())?;
        apply_permission_mode(&mut agent.acp, &resp.session_id, &ctx.permission_mode).await?;
    }'''
    if expected not in setup:
        raise ValueError('permission policy is not wired into session preparation')
    crate = output / 'policy-test'
    (crate / 'src').mkdir(parents=True)
    fixture = ROOT / 'tests/upstream-acp-permissions'
    (crate / 'src/lib.rs').write_text('#![allow(dead_code)]\n' + error + policy + (fixture / 'fixture.rs').read_text())
    for name in ('Cargo.toml', 'Cargo.lock'):
        shutil.copyfile(fixture / name, crate / name)
    print(crate)

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--buzz-source', required=True, type=Path)
    parser.add_argument('--output', required=True, type=Path)
    args = parser.parse_args()
    try:
        prepare(args.buzz_source.resolve(), args.output.absolute())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        parser.exit(1, 'permission contribution preparation failed: ' + str(error) + '\n')
