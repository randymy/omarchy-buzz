#!/bin/sh
# Render the marketplace preview card (root preview.png) with ImageMagick from
# the text art in assets/preview: the Buzz app icon as half-block characters
# (assets/preview/icon.txt, traced from block/buzz's Apache-2.0
# desktop/src-tauri/icons at 64×40 with `magick … -threshold 50%`; Buzz is
# Block's; this plugin is independent) over a small block-letter BUZZ
# wordmark, in Buzz yellow on the shell's dark background. Fonts:
# JetBrainsMono Nerd Font (installed on Omarchy).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
art="$root/assets/preview"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
bg='#14151c'; yellow='#e3d62e'; font='JetBrainsMono-NF-Bold'
magick -background "$bg" -fill "$yellow" -font "$font" -pointsize 24 -interline-spacing -8 label:@"$art/icon.txt" +repage "$tmp/icon.png"
magick -background "$bg" -fill "$yellow" -font "$font" -pointsize 22 -interline-spacing -6 label:@"$art/wordmark.txt" +repage "$tmp/word.png"
magick -size 1600x900 xc:"$bg" \
  "$tmp/icon.png" -gravity center -geometry +0-110 -composite \
  "$tmp/word.png" -gravity center -geometry +0+225 -composite \
  \( -background none -fill '#c9cbd6' -font "$font" -pointsize 30 label:'for Omarchy' +repage \) -gravity center -geometry +0+345 -composite \
  -strip "$root/preview.png"
echo "wrote $root/preview.png"
