#!/usr/bin/env python3
"""Install, upgrade, or remove a locally packaged Buzz helper and user units."""
import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import platform
import re
import shutil
import subprocess
import tarfile
import tempfile
import tomllib
from datetime import datetime, timezone

ROOT = Path(__file__).resolve().parents[1]
FILES = {
    "bin/omarchy-buzz": (".local/bin/omarchy-buzz", 0o755),
    "service/omarchy-buzz.service": (".config/systemd/user/omarchy-buzz.service", 0o644),
    "service/omarchy-buzz.socket": (".config/systemd/user/omarchy-buzz.socket", 0o644),
    "service/omarchy-buzz-agents.service": (".config/systemd/user/omarchy-buzz-agents.service", 0o644),
    "service/omarchy-buzz-agents.socket": (".config/systemd/user/omarchy-buzz-agents.socket", 0o644),
    "scripts/agent-login": (".local/share/omarchy-buzz/scripts/agent-login", 0o755),
    "scripts/agent-bundle": (".local/share/omarchy-buzz/scripts/agent-bundle", 0o755),
    "scripts/room-agent": (".local/share/omarchy-buzz/scripts/room-agent", 0o755),
    "scripts/room-sandbox": (".local/share/omarchy-buzz/scripts/room-sandbox", 0o755),
    "scripts/room-agent-entry": (".local/share/omarchy-buzz/scripts/room-agent-entry", 0o755),
    "scripts/room-codex": (".local/share/omarchy-buzz/scripts/room-codex", 0o755),
    "scripts/room-codex-acp": (".local/share/omarchy-buzz/scripts/room-codex-acp", 0o755),
    "scripts/room-claude": (".local/share/omarchy-buzz/scripts/room-claude", 0o755),
    "scripts/room-claude-acp": (".local/share/omarchy-buzz/scripts/room-claude-acp", 0o755),
}
# Installations before 0.0.13 have only these; the rest may be absent on upgrade.
CORE = ("bin/omarchy-buzz", "service/omarchy-buzz.service", "service/omarchy-buzz.socket")
REVIEWED = tuple(name for name in FILES if name != "bin/omarchy-buzz")
SOCKETS = ("omarchy-buzz.socket", "omarchy-buzz-agents.socket")
SERVICES = ("omarchy-buzz.service", "omarchy-buzz-agents.service")
# Hashes of the reviewed files as this installer last put them, so an upgrade
# recognizes its own earlier copies once the checkout's have moved on.
RECORD = ".local/share/omarchy-buzz/installed.json"
MAX_RECORD = 64 * 1024
MAX_ARCHIVE = 32 * 1024 * 1024
MAX_BINARY = 24 * 1024 * 1024


def regular(path):
    return not path.is_symlink() and path.is_file()


def safe_directory(path, create=True):
    missing = []
    current = path
    while not current.exists() and not current.is_symlink():
        missing.append(current)
        current = current.parent
    while current != current.parent:
        if current.is_symlink() or not current.is_dir():
            raise ValueError(f"unsafe directory: {current}")
        current = current.parent
    if create:
        for directory in reversed(missing):
            directory.mkdir(mode=0o700)


def destinations(home):
    if not home.is_absolute() or home.is_symlink() or not home.is_dir():
        raise ValueError("HOME must be an ordinary absolute directory")
    return {name: home / relative for name, (relative, _) in FILES.items()}


def digest(data):
    return hashlib.sha256(data).hexdigest()


def read_record(home):
    """The recorded hashes, or {} when the record is absent or not usable."""
    path = home / RECORD
    if not regular(path) or path.stat().st_size > MAX_RECORD:
        return {}
    try:
        record = json.loads(path.read_bytes())
    except (ValueError, UnicodeDecodeError):
        return {}
    if not isinstance(record, dict):
        return {}
    return {name: value for name, value in record.items()
            if name in REVIEWED and isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value)}


def write_record(home, content):
    path = home / RECORD
    safe_directory(path.parent)
    record = {name: digest(content[name]) for name in REVIEWED}
    put(path, json.dumps(record, indent=2, sort_keys=True).encode() + b"\n", 0o600)


def systemctl(*args, check=True):
    result = subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=15)
    if check and result.returncode:
        raise RuntimeError(f"systemctl --user {' '.join(args)} failed: {result.stderr.strip()[:300]}")
    return result.returncode == 0


def architecture(data):
    if len(data) < 64 or data[:7] != b"\x7fELF\x02\x01\x01":
        raise ValueError("package binary is not a little-endian 64-bit ELF")
    machine = int.from_bytes(data[18:20], "little")
    if machine not in (62, 183) or int.from_bytes(data[16:18], "little") not in (2, 3):
        raise ValueError("unsupported ELF executable")
    return {62: "x86_64", 183: "aarch64"}[machine]


def read_package(archive, sidecar):
    if (not regular(archive) or not regular(sidecar) or archive.stat().st_size > MAX_ARCHIVE
            or sidecar.stat().st_size > 65536):
        raise ValueError("package and checksum must be regular, bounded files")
    payload = archive.read_bytes()
    checksum = json.loads(sidecar.read_text())
    if not isinstance(checksum, dict):
        raise ValueError("invalid checksum document")
    artifacts = checksum.get("artifacts")
    if (type(checksum.get("schemaVersion")) is not int or checksum["schemaVersion"] != 1
            or not isinstance(artifacts, list) or len(artifacts) != 1
            or not isinstance(artifacts[0], dict)
            or artifacts[0].get("filename") != archive.name or artifacts[0].get("bytes") != len(payload)
            or artifacts[0].get("sha256") != hashlib.sha256(payload).hexdigest()):
        raise ValueError("package checksum mismatch")
    stem = archive.name.removesuffix(".tar.gz")
    if stem == archive.name or not re.fullmatch(r"omarchy-buzz-[0-9][A-Za-z0-9.-]*-linux-(?:x86_64|aarch64)", stem):
        raise ValueError("unexpected package name")
    content = {}
    total = 0
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as tar:
        members = tar.getmembers()
        if len(members) > 1033:
            raise ValueError("too many package members")
        for member in members:
            prefix = stem + "/"
            if (not member.isfile() or not member.name.startswith(prefix) or member.size > MAX_BINARY
                    or ".." in Path(member.name).parts):
                raise ValueError("unsafe package member")
            name = member.name[len(prefix):]
            if name in content:
                raise ValueError("duplicate package member")
            if name not in FILES and name not in ("version.json", "LICENSE", "service/README.md", "helper/README.md") and not name.startswith("third-party/"):
                raise ValueError("unexpected package member")
            total += member.size
            if total > MAX_ARCHIVE:
                raise ValueError("expanded package is too large")
            content[name] = tar.extractfile(member).read()
    if not set(FILES).issubset(content) or "version.json" not in content:
        raise ValueError("package is missing required files")
    metadata = json.loads(content["version.json"])
    if not isinstance(metadata, dict):
        raise ValueError("invalid package version metadata")
    if (metadata != checksum.get("version") or type(metadata.get("protocolVersion")) is not int
            or metadata["protocolVersion"] != 1):
        raise ValueError("package version metadata mismatch")
    binary = content["bin/omarchy-buzz"]
    arch = architecture(binary)
    if (metadata.get("architecture") != arch or metadata.get("os") != "linux"
            or metadata.get("binarySha256") != hashlib.sha256(binary).hexdigest()
            or not re.fullmatch(r"[0-9a-f]{40}", str(metadata.get("backendRevision")))
            or stem != f"omarchy-buzz-{metadata.get('helperVersion')}-linux-{arch}"):
        raise ValueError("package binary metadata mismatch")
    if arch != {"aarch64": "aarch64", "arm64": "aarch64", "x86_64": "x86_64"}.get(platform.machine()):
        raise ValueError("package architecture differs from this machine")
    manifest = json.loads((ROOT / "manifest.json").read_text())
    cargo = tomllib.loads((ROOT / "helper/Cargo.toml").read_text())
    pins = [cargo["dependencies"][name]["rev"] for name in ("buzz-sdk", "buzz-ws-client")]
    compatibility = (ROOT / "helper/src/compatibility.rs").read_text()
    pin = re.search(r'BUZZ_REVISION\s*:\s*&str\s*=\s*"([0-9a-f]{40})"', compatibility)
    if (metadata["helperVersion"] != manifest.get("version")
            or metadata["helperVersion"] != cargo["package"]["version"]
            or pins[0] != pins[1] or pin is None
            or metadata["backendRevision"] != pins[0] or metadata["backendRevision"] != pin[1]):
        raise ValueError("package does not match checkout version and Buzz pin")
    for name in REVIEWED:
        if content[name] != (ROOT / name).read_bytes():
            raise ValueError("package unit or script does not match the reviewed local copy")
    return {name: content[name] for name in FILES}, metadata


def probe_binary(data, expected):
    """Run only the explicitly trusted local package's version command in private temp space."""
    with tempfile.TemporaryDirectory(prefix="omarchy-buzz-probe-") as temporary:
        binary = Path(temporary) / "omarchy-buzz"
        binary.write_bytes(data)
        binary.chmod(0o700)
        result = subprocess.run([str(binary), "--version"], capture_output=True, timeout=10,
                                cwd=temporary)
    if result.returncode or result.stderr or len(result.stdout) > 4096:
        raise ValueError("packaged helper failed target --version probe")
    try:
        version = json.loads(result.stdout)
    except (ValueError, UnicodeDecodeError) as error:
        raise ValueError("packaged helper returned invalid version metadata") from error
    if (not isinstance(version, dict)
            or type(version.get("protocolVersion")) is not int
            or any(version.get(key) != expected[key] for key in
                   ("helperVersion", "protocolVersion", "backendRevision"))):
        raise ValueError("packaged helper version differs from package metadata")


def inspect_existing(paths, create=True, record=None):
    """An installed reviewed file must match the checkout's copy or the
    hash this installer recorded when it last put that file."""
    record = record or {}
    present = {}
    for name, path in paths.items():
        safe_directory(path.parent, create=create)
        if path.is_symlink() or (path.exists() and not path.is_file()):
            raise ValueError(f"unexpected installed path: {path}")
        present[name] = path.exists()
    core = [present[name] for name in CORE]
    if any(core) and not all(core):
        raise ValueError("partial installation; review installed files manually")
    if not all(core) and any(present[name] for name in FILES if name not in CORE):
        raise ValueError("partial installation; review installed files manually")
    if all(core):
        for name in REVIEWED:
            if not present[name]:
                continue
            data = paths[name].read_bytes()
            if data != (ROOT / name).read_bytes() and digest(data) != record.get(name):
                raise ValueError(f"modified or unrecognized unit: {paths[name]}")
        if paths["bin/omarchy-buzz"].stat().st_size > MAX_BINARY:
            raise ValueError("installed binary is too large")
        if architecture(paths["bin/omarchy-buzz"].read_bytes()[:64]) != {"arm64":"aarch64", "aarch64":"aarch64", "x86_64":"x86_64"}.get(platform.machine()):
            raise ValueError("installed binary architecture mismatch")
        result = subprocess.run([str(paths["bin/omarchy-buzz"]), "--version"],
                                capture_output=True, timeout=10)
        if result.returncode or result.stderr or len(result.stdout) > 4096:
            raise ValueError("unrecognized installed helper")
        version = json.loads(result.stdout)
        if (not isinstance(version, dict) or version.get("protocolVersion") != 1
                or not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9.-]+)?", str(version.get("helperVersion")))
                or not re.fullmatch(r"[0-9a-f]{40}", str(version.get("backendRevision")))):
            raise ValueError("unrecognized installed helper")
    return all(core)


def backup(paths, home):
    base = home / ".local/share/omarchy-buzz/backups"
    safe_directory(base)
    target = base / datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    target.mkdir(mode=0o700)
    for name, path in list(paths.items()) + [("installed.json", home / RECORD)]:
        if not regular(path):
            continue
        copy = target / name
        safe_directory(copy.parent)
        shutil.copy2(path, copy, follow_symlinks=False)
    return target


def put(path, data, mode):
    descriptor, staged = tempfile.mkstemp(prefix=".omarchy-buzz-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(staged, mode)
        os.replace(staged, path)
    finally:
        if os.path.exists(staged):
            os.unlink(staged)


def restore(paths, saved, home):
    for name, path in list(paths.items()) + [("installed.json", home / RECORD)]:
        mode = FILES[name][1] if name in FILES else 0o600
        if saved is None or not (saved / name).exists():
            path.unlink(missing_ok=True)
        else:
            put(path, (saved / name).read_bytes(), mode)
    systemctl("daemon-reload")


def install(home, archive, sidecar, dry_run=False):
    content, metadata = read_package(archive, sidecar)
    paths = destinations(home)
    existing = inspect_existing(paths, create=False, record=read_record(home))
    if dry_run:
        print(("Upgrade" if existing else "Install") + " preview:")
        for path in paths.values():
            print(f"  {path}")
        print("  systemctl --user: stop existing units if upgrading; daemon-reload; enable --now both sockets")
        if existing:
            print(f"  backup under {home / '.local/share/omarchy-buzz/backups'}")
        return
    probe_binary(content["bin/omarchy-buzz"], metadata)
    for path in paths.values():
        safe_directory(path.parent)
    agents_installed = existing and paths["service/omarchy-buzz-agents.socket"].exists()
    was_enabled = {socket: systemctl("is-enabled", socket, check=False) if existing else False for socket in SOCKETS}
    was_active = {socket: systemctl("is-active", socket, check=False) if existing else False for socket in SOCKETS}
    saved = backup(paths, home) if existing else None
    try:
        if existing:
            systemctl("stop", "omarchy-buzz.socket", "omarchy-buzz.service")
            if agents_installed:
                systemctl("stop", "omarchy-buzz-agents.socket", "omarchy-buzz-agents.service")
        for name, path in paths.items():
            put(path, content[name], FILES[name][1])
        write_record(home, content)
        systemctl("daemon-reload")
        for socket in SOCKETS:
            systemctl("enable", "--now", socket)
    except Exception:
        systemctl("stop", *SOCKETS, *SERVICES, check=False)
        if not existing:
            for socket in SOCKETS:
                systemctl("disable", "--now", socket, check=False)
        elif not agents_installed:
            systemctl("disable", "--now", "omarchy-buzz-agents.socket", check=False)
        restore(paths, saved, home)
        for socket in SOCKETS:
            if not existing or (socket == "omarchy-buzz-agents.socket" and not agents_installed):
                continue
            if was_enabled[socket]:
                systemctl("enable", socket)
            else:
                systemctl("disable", "--now", socket)
            if was_active[socket]:
                systemctl("start", socket)
        raise
    print(("Upgraded" if existing else "Installed") + f" helper; rollback: {saved or 'not needed'}")


def uninstall(home, dry_run=False):
    paths = destinations(home)
    if not inspect_existing(paths, create=not dry_run, record=read_record(home)):
        raise ValueError("helper is not installed")
    if dry_run:
        print("Uninstall preview:")
        for path in paths.values():
            print(f"  {path}")
        print("  systemctl --user: disable --now both sockets; stop services; daemon-reload")
        print(f"  backup under {home / '.local/share/omarchy-buzz/backups'}")
        return
    saved = backup(paths, home)
    installed = [socket for socket in SOCKETS if paths["service/" + socket].exists()]
    was_enabled = {socket: systemctl("is-enabled", socket, check=False) for socket in installed}
    was_active = {socket: systemctl("is-active", socket, check=False) for socket in installed}
    try:
        for socket in installed:
            systemctl("disable", "--now", socket)
            systemctl("stop", socket.replace(".socket", ".service"))
        for path in paths.values():
            path.unlink(missing_ok=True)
        (home / RECORD).unlink(missing_ok=True)
        systemctl("daemon-reload")
    except Exception:
        restore(paths, saved, home)
        for socket in installed:
            if was_enabled[socket]:
                systemctl("enable", socket)
            if was_active[socket]:
                systemctl("start", socket)
        raise
    print(f"Removed helper files; rollback: {saved}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    add = sub.add_parser("install", help="install or upgrade from a local package")
    add.add_argument("archive", type=Path)
    add.add_argument("--checksum", type=Path, help="matching .sha256.json (default: beside archive)")
    add.add_argument("--dry-run", action="store_true", help="validate and preview without changing files or units")
    remove = sub.add_parser("uninstall", help="remove only installed helper files and units")
    remove.add_argument("--dry-run", action="store_true", help="preview without changing files or units")
    args = parser.parse_args()
    try:
        home = Path(os.environ["HOME"])
        if args.command == "install":
            sidecar = args.checksum or args.archive.with_name(args.archive.name.removesuffix(".tar.gz") + ".sha256.json")
            install(home, args.archive, sidecar, args.dry_run)
        else:
            uninstall(home, args.dry_run)
    except (ValueError, OSError, RuntimeError, KeyError, json.JSONDecodeError,
            tarfile.TarError, subprocess.SubprocessError) as error:
        parser.exit(1, f"helper installation failed: {error}\n")


if __name__ == "__main__":
    main()
