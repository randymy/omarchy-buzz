#!/usr/bin/python3
"""Launch one explicitly configured, filesystem-isolated stock Buzz room agent.

Harnesses: `codex` (default, unchanged) and `claude-code`. Use a systemd user
unit for resource bounds and whole-cgroup cleanup. This is not a QML command
interface. Enrollment is a separate owner operation.

`--probe-model <model> --harness <h> --profile <dir> --bundle <dir>` (first) instead
runs one minimal non-interactive vendor turn with that model in the same
sandbox view (harness profile, read-only bundle), with a throwaway private
workspace and without a relay, agent key or `buzz-acp`, then exits with the
vendor CLI's status (124 after its deadline).
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import resource
import shutil
import stat
import subprocess
import sys
import tempfile
import uuid

sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader('room_sandbox', str(Path(__file__).with_name('room-sandbox')))
spec = importlib.util.spec_from_loader(loader.name, loader)
sandbox = importlib.util.module_from_spec(spec)
loader.exec_module(sandbox)

MAX_ROOMS = 8
MODEL = re.compile('[A-Za-z0-9._:-]{1,64}')
# buzz-acp resolves these names through PATH=/opt/agent/bin and recognizes both
# as its standard adapters (crates/buzz-acp/src/acp.rs, standard_adapter).
AGENT_COMMANDS = {'codex': 'codex-acp', 'claude-code': 'claude-agent-acp'}
# Persona respondTo -> buzz-acp --respond-to (crates/buzz-acp/src/config.rs,
# RespondTo: owner-only|allowlist|anyone|nobody). The subscription stays
# `mentions`, so `anyone` means any member's mention in the configured rooms.
RESPOND_TO = {'owner-only': 'owner-only', 'mentions': 'anyone'}
# Claude settings keys that could route around the subscription login.
CLAUDE_SETTINGS_REFUSED = ('apiKeyHelper', 'env', 'awsAuthRefresh', 'awsCredentialExport',
                           'gcpAuthRefresh', 'modelOverrides')
# The owner's NIP-OA attestation, `["auth", <owner hex>, <conditions>, <sig hex>]`
# (crates/buzz-sdk/src/nip_oa.rs, compute_auth_tag/parse_auth_tag). buzz-acp
# reads it from BUZZ_AUTH_TAG (crates/buzz-acp/src/lib.rs resolve_agent_owner
# and relay AUTH; run_task.rs REST client) and verifies the signature itself.
AUTH_TAG_LIMIT = 4 * 1024
LOWER_HEX = re.compile('[0-9a-f]+')
CONDITION = re.compile('(kind=|created_at<|created_at>)(0|[1-9][0-9]*)')
CONDITION_MAX = {'kind=': 65535, 'created_at<': 4294967295, 'created_at>': 4294967295}
# Model probe. Per-harness model names, as the agent service checks them
# (helper/src/agents_service/models.rs); the store's MODEL rule applies too.
CLAUDE_ALIASES = ('opus', 'sonnet', 'haiku', 'fable')
HARNESS_MODEL = {'claude-code': re.compile('claude-[a-z0-9-]+'),
                 'codex': re.compile('gpt-[a-z0-9.-]+|o[0-9][a-z0-9-]*|codex-[a-z0-9.-]+')}
PROBE_PROMPT = 'Reply with exactly OK'
# The bundle's vendor CLI wrappers (bin/claude <- room-claude, bin/codex <- room-codex).
PROBE_CLI = {'claude-code': 'claude', 'codex': 'codex'}
# Below the agent service's 90 s bound, so the sandbox is stopped and the
# throwaway workspace removed before the service gives up on this process.
PROBE_DEADLINE = 80
PROBE_TIMEOUT_EXIT = 124


def parser():
    p = argparse.ArgumentParser(description=__doc__)
    for name in ('profile', 'workspace', 'bundle'):
        p.add_argument('--' + name, type=Path, required=True)
    for name in ('relay', 'owner', 'identity'):
        p.add_argument('--' + name, required=True)
    p.add_argument('--room', action='append', default=[],
                   help='canonical channel UUID; repeat for up to 8 rooms (optional with --answers-dms)')
    p.add_argument('--answers-dms', action='store_true',
                   help='no channel filter: listen in every channel the agent is a member of, '
                        'including direct messages opened with it')
    p.add_argument('--harness', choices=sandbox.HARNESSES, default='codex')
    p.add_argument('--respond-to', choices=tuple(RESPOND_TO), default='owner-only')
    p.add_argument('--instructions', type=Path,
                   help='0600 persona instructions file written by the agent service')
    p.add_argument('--model', help='harness model ID; empty or absent keeps the harness default')
    p.add_argument('--auth-tag', type=Path,
                   help='0600 owner NIP-OA attestation file written by the agent service')
    return p


def probe_parser():
    p = argparse.ArgumentParser(prog='room-agent', description='Probe one model in the agent sandbox.')
    p.add_argument('--probe-model', required=True, help='the model to try, as the persona stores it')
    p.add_argument('--harness', choices=sandbox.HARNESSES, required=True)
    for name in ('profile', 'bundle'):
        p.add_argument('--' + name, type=Path, required=True)
    return p


def check_probe_model(p, a):
    """The model must name a model of the harness. Exits via p.error."""
    model = a.probe_model
    if not MODEL.fullmatch(model):
        p.error('model_invalid')
    alias = a.harness == 'claude-code' and model in CLAUDE_ALIASES
    if not alias and not HARNESS_MODEL[a.harness].fullmatch(model):
        p.error('model_not_for_harness')


def probe_command(harness, model):
    """The exact vendor argv of the probe turn (fixed; only the model varies).

    Claude Code (`/opt/agent/bin/claude` adds the forced-subscription flag
    settings, as for the agent): print mode, one turn, plain text, no tools and
    no saved session. `--max-turns` is a hidden option of CLI 2.1.280 ("only
    works with --print"); the others are in `claude --help`. Codex
    (`/opt/agent/bin/codex` adds `-c forced_login_method=chatgpt`): `codex
    exec`, read-only sandbox, outside a Git repository, no saved session, no
    colour (`codex exec --help`, 0.158.0).
    """
    if harness == 'claude-code':
        return ['/opt/agent/bin/' + PROBE_CLI[harness], '-p', PROBE_PROMPT, '--model', model, '--max-turns', '1',
                '--output-format', 'text', '--tools', '', '--no-session-persistence']
    return ['/opt/agent/bin/' + PROBE_CLI[harness], 'exec', '--model', model, '--sandbox', 'read-only',
            '--skip-git-repo-check', '--ephemeral', '--color', 'never', PROBE_PROMPT]


def probe_argv(a, workspace):
    """Validate paths and return the probe's bwrap argv: the agent's view with
    `workspace` (a fresh private directory) at /workspace, no relay, no fd 3."""
    sandbox.validate(a.profile, workspace, a.bundle)
    check_bundle_harness(a.bundle, a.harness)
    cli = a.bundle / 'bin' / PROBE_CLI[a.harness]
    if cli.is_symlink() or not cli.is_file():
        raise sandbox.Refused('bundle_harness_mismatch')
    if a.harness == 'claude-code':
        check_claude_settings(a.profile)
    return sandbox.build_command(a.profile, workspace, a.bundle, probe_command(a.harness, a.probe_model),
                                 harness=a.harness)


def probe_workspace_parent():
    """The user's runtime directory when it is private, else the system default."""
    runtime = os.environ.get('XDG_RUNTIME_DIR', '')
    if runtime.startswith('/'):
        try:
            return str(sandbox.private_directory(Path(runtime)))
        except sandbox.Refused:
            pass
    return None


def run_probe(argv, deadline=PROBE_DEADLINE):
    """Run the sandbox with stderr on stdout; stop it at the deadline."""
    child = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stderr=subprocess.STDOUT)
    try:
        return child.wait(timeout=deadline)
    except subprocess.TimeoutExpired:
        child.kill()
        child.wait()
        print('room-agent: probe_timeout', flush=True)
        return PROBE_TIMEOUT_EXIT


def probe_main(argv):
    p = probe_parser()
    a = p.parse_args(argv)
    check_probe_model(p, a)
    workspace = Path(tempfile.mkdtemp(prefix='omarchy-buzz-probe-', dir=probe_workspace_parent()))
    try:
        try:
            command = probe_argv(a, workspace)
        except sandbox.Refused as exc:
            p.error(str(exc))
        return run_probe(command)
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def check_arguments(p, a):
    """Validate everything that does not need the filesystem. Exits via p.error."""
    if any(not re.fullmatch('[0-9a-f]{64}', x) for x in (a.owner, a.identity)) or a.owner == a.identity:
        p.error('separate_agent_and_owner_required')
    # With --answers-dms relay membership defines the scope; rooms given anyway
    # are still checked but not passed on.
    if not (0 if a.answers_dms else 1) <= len(a.room) <= MAX_ROOMS:
        p.error('room_count_invalid')
    for room in a.room:
        try:
            canonical = str(uuid.UUID(room))
        except ValueError:
            canonical = None
        if canonical != room:
            p.error('canonical_room_required')
    if len(set(a.room)) != len(a.room):
        p.error('duplicate_room')
    if a.model == '':
        a.model = None
    if a.model is not None and not MODEL.fullmatch(a.model):
        p.error('model_invalid')


def check_bundle_harness(bundle, harness):
    entry = bundle / 'bin' / AGENT_COMMANDS[harness]
    if entry.is_symlink() or not entry.is_file():
        raise sandbox.Refused('bundle_harness_mismatch')


def check_claude_settings(profile):
    """Refuse user settings that could select API or third-party routing.

    The flag settings in the bundle force the Claude subscription login; these
    lower-precedence keys are refused rather than trusted to lose.
    """
    path = profile / 'provider' / 'settings.json'
    if path.is_symlink():
        raise sandbox.Refused('provider_settings_review_required')
    if not path.exists():
        return
    info = path.stat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_size > 1024 * 1024:
        raise sandbox.Refused('provider_settings_review_required')
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise sandbox.Refused('provider_settings_review_required') from exc
    if (not isinstance(value, dict) or any(key in value for key in CLAUDE_SETTINGS_REFUSED) or
            value.get('forceLoginMethod', 'claudeai') != 'claudeai'):
        raise sandbox.Refused('provider_settings_review_required')


def valid_conditions(conditions):
    """NIP-OA conditions as buzz-sdk's validate_conditions accepts them."""
    if conditions == '':
        return True
    for clause in conditions.split('&'):
        match = CONDITION.fullmatch(clause)
        if not match or int(match.group(2)) > CONDITION_MAX[match.group(1)]:
            return False
    return True


def auth_tag_value(a):
    """The validated attestation as the canonical JSON buzz-sdk emits, or None.

    The file passes the same checks as --instructions (4 KiB limit) and must
    name --owner. The value only ever travels through the memfd options.
    """
    if a.auth_tag is None:
        return None
    data = sandbox.service_file(a.auth_tag, a.profile, a.workspace, a.bundle, 'auth_tag', AUTH_TAG_LIMIT)
    try:
        value = json.loads(data.decode('utf-8'))
    except (UnicodeDecodeError, ValueError) as exc:
        raise sandbox.Refused('auth_tag_file_invalid') from exc
    if (not isinstance(value, list) or len(value) != 4 or not all(isinstance(v, str) for v in value) or
            value[0] != 'auth' or len(value[1]) != 64 or not LOWER_HEX.fullmatch(value[1]) or
            not valid_conditions(value[2]) or len(value[3]) != 128 or not LOWER_HEX.fullmatch(value[3])):
        raise sandbox.Refused('auth_tag_file_invalid')
    if value[1] != a.owner:
        raise sandbox.Refused('auth_tag_owner_mismatch')
    return json.dumps(value, separators=(',', ':')).encode('ascii')


def identity_options(key, auth_tag):
    """The bwrap --args options (NUL-separated) written to the memfd on fd 3."""
    options = b'--setenv\0BUZZ_PRIVATE_KEY\0' + key + b'\0'
    if auth_tag is not None:
        options += b'--setenv\0BUZZ_AUTH_TAG\0' + auth_tag + b'\0'
    return options


def agent_command(a):
    """The exact buzz-acp argv run inside the sandbox."""
    # Without --channels buzz-acp subscribes to every channel it is a member of
    # and follows new memberships (crates/buzz-acp/src/config.rs,
    # resolve_channel_filters and resolve_dynamic_channel_filter), so direct
    # messages opened with the agent reach it. In a DM it answers only its
    # owner whatever --respond-to says (lib.rs author_allowed).
    channels = [] if a.answers_dms else ['--channels', ','.join(a.room)]
    command = ['/opt/agent/bin/room-agent-entry', '--agent-command', AGENT_COMMANDS[a.harness],
               '--agent-owner', a.owner, *channels, '--subscribe', 'mentions',
               '--respond-to', RESPOND_TO[a.respond_to], '--permission-mode', 'default', '--agents', '1',
               '--heartbeat-interval', '0', '--max-turn-duration', '180', '--idle-timeout', '60']
    if a.instructions is not None:
        # Same buzz-acp system prompt Desktop sets through BUZZ_ACP_SYSTEM_PROMPT;
        # the file form keeps up to 16 KiB of text out of process arguments.
        command += ['--system-prompt-file', sandbox.INSTRUCTIONS_TARGET]
    if a.model is not None and a.harness == 'codex':
        # Desktop: BUZZ_ACP_MODEL (same clap argument as --model).
        command += ['--model', a.model]
    return command


def launch_argv(a):
    """Validate paths and return the bwrap argv; fd 3 carries the identity options
    (BUZZ_PRIVATE_KEY and, with --auth-tag, BUZZ_AUTH_TAG)."""
    sandbox.validate(a.profile, a.workspace, a.bundle)
    sandbox.relay_url(a.relay)
    check_bundle_harness(a.bundle, a.harness)
    instructions = None
    if a.instructions is not None:
        instructions = sandbox.instructions_file(a.instructions, a.profile, a.workspace, a.bundle)
    extra_env = {}
    if a.harness == 'claude-code':
        check_claude_settings(a.profile)
        if a.model is not None:
            # Desktop's single startup model authority for local Claude agents.
            extra_env['ANTHROPIC_MODEL'] = a.model
    argv = sandbox.build_command(a.profile, a.workspace, a.bundle, agent_command(a), a.relay,
                                 harness=a.harness, instructions=instructions, extra_env=extra_env)
    position = argv.index('--chdir')
    argv[position:position] = ['--args', '3']
    return argv


def main():
    # The service always passes it first; a unit's ExecStart never does.
    if sys.argv[1:2] == ['--probe-model']:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        sys.exit(probe_main(sys.argv[1:]))
    p = parser()
    a = p.parse_args()
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    check_arguments(p, a)
    try:
        argv = launch_argv(a)
        auth_tag = auth_tag_value(a)
    except sandbox.Refused as exc:
        p.error(str(exc))
    result = subprocess.run(['/usr/bin/secret-tool', 'lookup', 'service', 'omarchy-buzz.room-agent.v1',
                             'account', a.identity], capture_output=True, timeout=15)
    key = result.stdout.strip()
    if result.returncode or not re.fullmatch(rb'[0-9a-f]{64}', key):
        p.error('agent_identity_unavailable')
    fd = os.memfd_create('buzz-agent-identity', 0)
    os.write(fd, identity_options(key, auth_tag))
    os.lseek(fd, 0, os.SEEK_SET)
    if fd != 3:
        os.dup2(fd, 3); os.close(fd)
    os.set_inheritable(3, True)
    os.execv(argv[0], argv)


if __name__ == '__main__':
    main()
